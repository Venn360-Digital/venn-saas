# Configuração do pnpm. O repo saiu do npm em 2026-11-12, preparando o
# monorepo — um gerenciador por vez, e esta é a etapa isolada da troca.
#
# `strict-peer-dependencies=false` é o equivalente do `legacy-peer-deps=true`
# que o npm usava aqui: a árvore tem peer declarado em faixa que não casa (o
# ecossistema React 19 + libs que ainda pedem 18), e abortar por isso impediria
# a instalação inteira. Falso não ignora o conflito — ele continua no relatório
# de instalação; só deixa de ser fatal.
strict-peer-dependencies=false

# `node_modules` PLANO, como o do npm — e esta linha é a que faz o build
# existir.
#
# O layout padrão do pnpm é uma árvore de symlinks para `.pnpm/`, e o vite
# segue symlink ao resolver módulo. Com ele, o build de preview de 12/11 ficou
# **30 minutos** parado em `[1/5] analyze client references... transforming...`
# e morreu no teto de tempo do Workers Builds (build e7689194) — install em
# 17,9 s, typechecks verdes, e o vite sem sair do lugar depois disso. Com
# layout plano, o resolvedor vê a mesma árvore que via no npm.
#
# O que se perde: o isolamento estrito, que acusaria uma dependência usada sem
# ser declarada. O que se ganha: install em segundos, lockfile determinístico e
# store compartilhado — o que esta migração foi buscar. O isolamento pode ser
# revisitado quando o monorepo existir e o build for medido de novo.
node-linker=hoisted

# A outra metade do `legacy-peer-deps`: o npm não instalava peer nenhum por
# conta própria, e o pnpm instala por padrão. A diferença não é teórica — a
# primeira instalação trouxe **webpack e a árvore dele inteira** (terser,
# @webassemblyjs/*, watchpack, schema-utils: 34 pacotes), porque
# `react-server-dom-webpack` declara webpack como peer. Aqui o build é
# vite/vinext; webpack é peso morto no `node_modules` e no install do CI.
# Falso = a mesma árvore que a produção já roda, que é o objetivo desta etapa:
# trocar o gerenciador sem trocar as dependências.
auto-install-peers=false

# Chave do npm, mantida de propósito: o pnpm a ignora em silêncio (medido), e
# ela é o que faz `npm install` ainda terminar aqui — para quem clonar o repo
# sem pnpm, ou para uma emergência em que só o npm esteja à mão. Sem ela, o
# peer do typechat (zod@^3 contra o zod@4 do projeto) aborta a instalação.
legacy-peer-deps=true

# `pre`/`post` scripts ligados EXPLICITAMENTE, e não por confiar no padrão.
#
# Deles dependem duas redes de segurança: `prebuild` (que roda os quatro
# linters estáticos antes de qualquer build) e `preportao:prod`/`preportao:stg`
# (que rodam `verificar` — os dois typechecks mais os linters — antes da
# migração de banco e da publicação). O pnpm 10.32 roda esses hooks por
# padrão, mas o padrão já foi `false` em versões anteriores: um upgrade de
# pnpm desligaria o portão SEM AVISO, e o deploy seguiria publicando.
# Declarar aqui custa uma linha e remove essa classe de falha silenciosa.
enable-pre-post-scripts=true
