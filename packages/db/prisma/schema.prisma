// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

/**
 * DOIS clientes gerados, e não é duplicação — é exigência medida.
 * O cliente com `runtime = "workerd"` importa o engine wasm e **só funciona
 * dentro de um bundler que resolva esse import**. Em Node ele falha com
 * "The loaded wasm module was unexpectedly `undefined` or `null` once loaded"
 * (medido em 2026-10-22). O inverso também vale: o de Node não serve ao Worker.
 * O gerador antigo (`prisma-client-js`) não resolvia isso de jeito nenhum: o
 * wasm dele mora dentro de `node_modules` e o plugin Vite da Cloudflare não o
 * empacotava — o deploy subia sem `.wasm` e toda consulta morria em
 * `PrismaClientInitializationError`. No gerador novo o wasm é emitido DENTRO da
 * saída, como arquivo do projeto, e o bundler o vê.
 * Quem escolhe entre os dois é o campo `imports` do `package.json`, pela
 * condição `workerd`. Ver `#prisma` lá.
 */
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"

  previewFeatures = ["postgresqlExtensions"]
}

generator clientWorkerd {
  provider     = "prisma-client"
  output       = "../src/generated/prisma-workerd"
  runtime      = "workerd"
  moduleFormat = "esm"

  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================
// 1. MULTI-TENANCY CORE
// ============================================

model User {
  termsAcceptances TermsAcceptance[]
  id               String            @id @default(cuid())
  email            String            @unique
  /// Se o e-mail foi confirmado. Exigido pelo Better Auth.
  ///
  /// `false` por omissão, e a confirmação **não** é exigida para entrar no
  /// primeiro corte: o cadastro está aberto de propósito desde 2026-10-07 para
  /// homologação, e somar um fluxo de e-mail ao corte que já troca banco, cofre,
  /// storage e identidade seria concentrar risco. Entra junto com o portão de
  /// cadastro, antes do lançamento.
  emailVerified    Boolean           @default(false)
  name             String?
  lastName         String? // Sobrenome
  phone            String? // WhatsApp
  hashedPassword   String? // Senha hash (para alteração de senha)
  avatar           String?
  /// Texto já normalizado para busca — minúsculo e sem acento.
  ///
  /// Coluna GERADA pelo Postgres (ver a migração
  /// `20261010100000_accent_insensitive_search`): existe aqui para que o Prisma
  /// possa filtrar por ela, e **nunca deve ser escrita** — o banco recusa. É o
  /// que faz "André" e "andre" localizarem a mesma pessoa sem SQL cru em cada
  /// rota de busca.
  searchText       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Multi-workspace support
  workspaces    WorkspaceUser[]
  /// As contas das quais esta pessoa é o MASTER.
  accounts      Account[]
  activities    Activity[]
  deals         Deal[]
  professionals Professional[]

  /// Sessões e credenciais do Better Auth.
  ///
  /// `authAccounts` e não `accounts` porque `accounts` já é das contas de
  /// cobrança — a colisão é o motivo de os modelos da biblioteca levarem
  /// prefixo. Ver `src/lib/auth/better-auth.ts`.
  authSessions           AuthSession[]
  authAccounts           AuthAccount[]
  /// Os recados que esta pessoa mandou e recebeu — ver `TeamMessage`.
  recadosEnviados        TeamMessage[]              @relation("RecadosEnviados")
  recadosRecebidos       TeamMessage[]              @relation("RecadosRecebidos")
  conversasQueColabora   ConversationCollaborator[] @relation("ConversasQueColabora")
  convitesQueEnviou      Invite[]                   @relation("ConvitesQueEnviou")
  conviteQueAceitou      Invite[]                   @relation("ConviteQueAceitou")
  colaboradoresQueChamou ConversationCollaborator[] @relation("ColaboradoresQueChamou")

  @@map("users")
}

/// Quem paga — o cliente, acima das clínicas dele.
///
/// Nasceu para o Multiclínica: um plano que inclui até três unidades precisa de
/// algo **acima** do workspace para comprá-lo. Sem esta entidade, "o plano
/// inclui 3" não teria onde morar, e a alternativa — eleger um workspace
/// primário e fazer os outros apontarem para ele — deixaria um caso especial
/// permanente em toda consulta de cobrança.
///
/// A decisão de cobrar na conta, e não por workspace, é de 2026-10-18. Três
/// assinaturas independentes para o mesmo dono significariam três datas de
/// renovação, três cartões, créditos que não se somam entre unidades e — o
/// pior — cancelar uma sem cancelar as outras, com o cliente achando que
/// cancelou tudo.
///
/// Hoje é **uma conta por workspace**: a migração que a criou não muda
/// comportamento nenhum. O que ela cria é o lugar onde o segundo workspace vai
/// caber.
model Account {
  id   String @id @default(cuid())
  name String

  /// O MASTER da assinatura: quem contrata, paga e governa todas as unidades.
  ///
  /// Explícito, e não deduzido do papel OWNER de algum workspace: com três
  /// unidades, "o dono de qual delas?" não tem resposta boa. `SetNull` porque
  /// remover a pessoa não pode levar a conta junto.
  ownerUserId String?

  /// O CPF ou CNPJ de **cobrança**: de quem assina, não da clínica.
  ///
  /// Mora aqui e não na unidade porque é um por fatura. Pode se repetir na
  /// unidade sem contradição: as unidades podem ser filiais do mesmo CNPJ ou
  /// franquias com CNPJ próprio, e `workspaces.cnpj` continua existindo para o
  /// segundo caso — vazio na filial, que é o caso comum.
  ///
  /// **Aceita os dois** por decisão do Andre em 2026-10-18: dentista sozinho
  /// às vezes não tem CNPJ, e o Asaas recebe os dois no mesmo campo
  /// (`cpfCnpj`). Era `cnpj`, e o nome mentia sobre o que passou a caber.
  cpfCnpj String?

  /// O endereço de **cobrança**: o do pagador, não o da clínica.
  ///
  /// Estruturado em campos separados porque é o que o cartão exige — o Asaas
  /// recusa o checkout sem `address`, `addressNumber`, `province`,
  /// `postalCode` e `phoneNumber`. `workspaces.address` continua existindo e é
  /// outra coisa: uma linha de texto livre com o endereço onde o paciente
  /// chega, que pode ser diferente em cada unidade.
  ///
  /// Tudo opcional no banco e obrigatório **na hora de contratar**: a avaliação
  /// de 7 dias não pede endereço, e pedir no cadastro é atrito antes de a
  /// clínica ver o produto.
  postalCode    String?
  address       String?
  addressNumber String?
  complement    String?
  /// Bairro. `province` é o nome que o Asaas usa, e manter o mesmo evita a
  /// tradução de ida e volta em cada chamada.
  province      String?
  city          String?
  /// UF, duas letras.
  state         String?
  /// Telefone de cobrança, só dígitos com DDD.
  billingPhone  String?

  /// O cliente desta conta no Asaas, criado na primeira cobrança.
  ///
  /// Único porque é 1:1 — duas contas apontando para o mesmo cliente fariam a
  /// assinatura de uma cobrar a outra. Nulo até a primeira contratação: a
  /// avaliação de 7 dias não pede cartão nem documento.
  asaasCustomerId String? @unique

  /// Conta vitalícia: usa o produto e nunca é cobrada.
  ///
  /// Existe porque a Venn360 é a conta de teste do produto — decisão do Andre
  /// em 2026-10-18 — e não por generosidade com cliente. Uma marca explícita é
  /// melhor que uma assinatura falsa com data de renovação eterna, que os
  /// relatórios somariam como receita.
  billingExempt Boolean @default(false)

  /// Quando esta conta passa a ser cobrada.
  ///
  /// Para quem já estava usando de graça quando a cobrança nasceu: a Implante Ja
  /// começa em 27/10/2026. Antes desta data o sistema não cobra e não corta;
  /// depois, segue a regra de todo mundo. Nulo = cobra desde já.
  billingStartsAt DateTime?

  /// A moeda em que a conta vê dinheiro: negócios, painel, procedimentos, produtos.
  ///
  /// Da conta e não da unidade pelo mesmo motivo da logomarca — o painel soma
  /// negócios de unidades irmãs na mesma coluna, e duas moedas dentro de uma
  /// conta fariam a soma mentir.
  ///
  /// **Não** vale para a cobrança da plataforma: plano, fatura e checkout
  /// seguem em BRL, que é o que o Asaas liquida e a moeda da tabela de preços.
  /// Decisão do Andre em 2026-11-03.
  ///
  /// ISO 4217, validado na borda contra `CODIGOS_DE_MOEDA` (`src/lib/moedas.ts`)
  /// e não por enum do Postgres: a lista de moedas cresce por pedido de cliente,
  /// e cada uma viraria uma migração com `ALTER TYPE` — destrutivo pelo lint, e
  /// caro para o que é, no fim, uma chave de formatação.
  ///
  /// `BRL` por omissão, que é o que toda conta existente já mostrava.
  currency String @default("BRL")

  /// A logomarca que substitui a do produto no cabeçalho do sistema.
  ///
  /// Da conta, e não da unidade, por um motivo de tela: lida da unidade, a
  /// marca mudaria ao trocar de clínica — e é justamente a parte do cabeçalho
  /// que não deve mudar. Uma conta, uma marca.
  logo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  workspaces     Workspace[]
  subscription   Subscription?
  unitAddons     UnitAddon[]
  trainingAddons TrainingAddon[]
  invoices       Invoice[]
  checkouts      AsaasCheckout[]
  paymentCards   PaymentCard[]

  @@index([ownerUserId])
  @@map("accounts")
}

/// Uma unidade comprada fora do que o plano inclui.
///
/// Uma linha por unidade adquirida, e o teto da conta é "o que o plano inclui +
/// quantas linhas destas existem". É o mesmo desenho de `CreditPurchase`: o
/// saldo é derivado das compras, não guardado num contador que pode divergir
/// delas — e aqui a diferença pesa mais, porque um contador errado ou tranca a
/// clínica fora de uma unidade que ela pagou, ou lhe dá uma de graça.
///
/// `priceCents` guarda o preço cobrado, não o de tabela: se os R$ 290 mudarem,
/// o que a clínica pagou continua escrito.
/// Um treinamento de agente contratado — serviço, não recurso do sistema.
///
/// **Compra única**, como o lote de crédito e diferente da unidade adicional:
/// treinar é um projeto com começo e fim, e cobrar por mês um trabalho que
/// acabou é assinatura de nada. Por isso não há `endsAt` nem `canceledAt` aqui
/// — o que existe é o andamento do serviço, em `status`.
///
/// Da **conta** e não da unidade: quem contrata é quem paga, e o agente
/// treinado pode ser de qualquer clínica dela.
model TrainingAddon {
  id        String @id @default(cuid())
  accountId String

  /// Em centavos, o que foi cobrado. Zero quando veio no plano.
  priceCents Int @default(0)

  /// "purchased" | "plan" — comprado à parte, ou incluído no plano.
  ///
  /// O plano de topo em 12 meses dá um (ver `treinamentoIncluido`), e a origem
  /// precisa ficar registrada: é ela que impede o brinde de ser concedido duas
  /// vezes à mesma conta, e é ela que explica, na tela, por que aquele item não
  /// tem valor nenhum ao lado.
  origin String @default("purchased")

  /// "pending" | "scheduled" | "done" — o andamento do serviço.
  ///
  /// Começa pendente porque o trabalho é humano: ninguém treina um agente num
  /// webhook. A tela diz "nossa equipe entra em contato" e este campo é o que
  /// sustenta a frase.
  status String @default("pending")

  /// O agente que este treinamento vai afinar, quando já se sabe qual.
  ///
  /// Nulo na contratação, de propósito: na maior parte das vendas o agente nem
  /// existe ainda. `SetNull` porque apagar o agente não pode apagar o registro
  /// de um serviço que foi pago.
  agentId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Quando o serviço foi entregue.
  doneAt    DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([accountId, status])
  @@map("training_addons")
}

model UnitAddon {
  id         String   @id @default(cuid())
  accountId  String
  priceCents Int      @default(0)
  createdAt  DateTime @default(now())

  /// Quando o cliente pediu o cancelamento, e quando ele deixa de valer.
  ///
  /// Cancelar não apaga a linha. O adicional é contrato à parte e o ciclo já
  /// foi pago: a unidade continua de pé até a renovação, e é `endsAt` que o
  /// diz. Toda contagem de teto filtra por ele — linha vencida não conta, e a
  /// renovação seguinte derruba os limites pela tabela, sozinha.
  canceledAt DateTime?
  endsAt     DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([accountId, endsAt])
  @@map("unit_addons")
}

/// Um evento recebido do webhook do Asaas, gravado antes de ser processado.
///
/// Existe por duas frases da documentação deles. A entrega é **at least once**,
/// então o mesmo evento chega mais de uma vez e processar duas vezes dobraria
/// crédito — o `@unique` em `asaasEventId` é a trava. E **depois de 15 falhas
/// consecutivas o Asaas interrompe a fila**: os eventos continuam a ser gerados
/// e não são enviados até alguém reativar. Por isso a rota grava, responde 200 e
/// processa na fila: um erro nosso não pode ser a resposta que o Asaas conta.
///
/// `payload` guarda o corpo inteiro. Quando a interpretação de um evento mudar —
/// e vai mudar —, dá para reprocessar o que já chegou em vez de pedir reenvio.
model AsaasEvent {
  id String @id @default(cuid())

  /// O `id` do evento no Asaas. A trava de idempotência.
  asaasEventId String @unique
  /// "PAYMENT_CONFIRMED", "CHECKOUT_PAID"…
  event        String
  payload      Json

  receivedAt  DateTime  @default(now())
  /// Nulo = ainda não processado. Preenchido = não processa de novo.
  processedAt DateTime?
  /// A última falha, para o vigia e para quem for depurar.
  error       String?   @db.Text
  attempts    Int       @default(0)

  @@index([event, receivedAt])
  @@index([processedAt])
  @@map("asaas_events")
}

/// Uma tentativa de contratar: o checkout criado, esperando pagamento.
///
/// Existe porque contratar deixou de ser instantâneo. Entre clicar em
/// "Contratar" e o plano valer há um redirecionamento para fora, um Pix ou um
/// cartão, e um webhook — e nesse intervalo a tela precisa dizer "estamos
/// esperando a confirmação" em vez de "sem plano", que é o que ela diria sem
/// esta linha.
///
/// O id desta linha vai no `externalReference` do checkout. É assim que o
/// webhook sabe **qual conta e qual plano** foram pagos: sem isso, a volta do
/// pagamento seria um pagamento órfão que alguém teria de conciliar à mão.
model AsaasCheckout {
  id String @id @default(cuid())

  accountId String
  /// "flow" | "pro" | "advanced" — o plano que esta tentativa contrata.
  plan      String

  /// O checkout no Asaas, e o link para onde o pagador foi mandado.
  asaasCheckoutId String @unique
  link            String

  /// ACTIVE | PAID | CANCELED | EXPIRED — espelho do que o Asaas diz.
  status String @default("ACTIVE")

  /// "assinatura" | "proporcional" | "adicionais".
  ///
  /// O processador precisa saber qual é: o primeiro cria assinatura no Asaas e
  /// manda procurá-la; o segundo é cobrança avulsa sobre uma assinatura que já
  /// existe, e o que ele faz é aplicar o plano e **atualizar o valor** da
  /// recorrência para os próximos ciclos. O terceiro não toca no plano: credita
  /// o lote avulso, cria as linhas de unidade adicional e sobe o valor da
  /// recorrência.
  kind String @default("assinatura")

  /// O que a compra de adicionais trazia, para o webhook poder aplicá-la.
  ///
  /// O evento do Asaas devolve valor e referência, nunca a cesta — sem estas
  /// colunas, um `CHECKOUT_PAID` de adicionais seria dinheiro recebido sem
  /// saber o que entregar. Nulos num checkout de plano.
  packCredits    Int?
  packPriceCents Int?
  units          Int?
  /// Quantos treinamentos de agente esta cesta trazia. Compra única.
  trainings      Int?
  /// "monthly" | "annual" — o ciclo que esta tentativa contrata.
  ///
  /// O evento do Asaas não diz o ciclo, e o valor pago não serve para deduzi-lo:
  /// doze meses de Digital e um mês de Multiclínica são números diferentes hoje
  /// e podem não ser amanhã. Sem esta coluna, um `CHECKOUT_PAID` de assinatura
  /// anual ativaria uma assinatura mensal — cliente cobrado por doze, com
  /// renovação marcada para trinta dias.
  cycle          String  @default("monthly")
  /// A unidade de onde a compra partiu: o lote de crédito avulso é dela.
  workspaceId    String?

  /// Em centavos, o valor que estava sendo cobrado quando foi criado.
  valueCents Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  paidAt    DateTime?

  /// Quando o **plano foi aplicado** por causa deste checkout.
  ///
  /// Separado de `status`/`paidAt` porque eles são espelho do Asaas e este é
  /// registro do nosso trabalho — e confundir os dois já custou uma ativação.
  /// O processador marcava `PAID` **antes** de aplicar o plano e usava esse
  /// mesmo `PAID` como trava de idempotência: quando a aplicação falhou, a
  /// retentativa viu "já está paga" e desistiu em silêncio. Cliente pagou,
  /// Asaas confirmou, plano não mudou, nenhum erro registrado.
  appliedAt DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([status])
  @@map("asaas_checkouts")
}

/// O espelho de uma cobrança do Asaas, para a tela não depender da API.
///
/// **Não é o livro-caixa.** Recebimento, conciliação e inadimplência de verdade
/// são do ERP do Andre, que é o próprio Asaas — decisão registrada em
/// PRODUCT.md §13. Isto existe para a guia Plano responder "o que eu paguei e
/// quando" sem uma chamada externa a cada abertura, e para o job de conciliação
/// ter contra o que comparar.
/// Um cartão que já pagou alguma coisa desta conta.
///
/// Nunca guarda o número.** Só o token do Asaas, a bandeira e os quatro
/// dígitos finais — que é tudo o que uma tela mostra e tudo o que a troca de
/// cartão precisa.
///
/// Existe porque `PUT /subscriptions/{id}/creditCard` aceita o cartão inteiro
/// ou um token já conhecido (medido no sandbox em 2026-10-19). Com o token, a
/// troca acontece sem o PAN passar pela nossa aplicação — que é a mesma razão
/// de o checkout ser hospedado (ver PRODUCT.md §13).
///
/// O token chega sozinho: todo pagamento no cartão volta com ele no evento.
/// Então a lista se preenche de uso, e um cartão novo entra pagando qualquer
/// cobrança na página do Asaas.
model PaymentCard {
  id        String @id @default(cuid())
  accountId String

  /// O token do Asaas. Único: é o mesmo cartão.
  asaasToken String  @unique
  brand      String?
  last4      String?

  /// O que cobra a mensalidade hoje. Um por conta, garantido por índice único
  /// parcial — a rota sozinha não resolve duas abas marcando ao mesmo tempo.
  isDefault Boolean @default(false)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("payment_cards")
}

model Invoice {
  id        String @id @default(cuid())
  accountId String

  /// A cobrança no Asaas. Única: é o espelho de uma linha de lá.
  asaasPaymentId      String  @unique
  /// A assinatura que a gerou, quando vem de uma. Nulo em compra avulsa.
  asaasSubscriptionId String?

  /// "subscription" | "credits" | "units" — o que esta cobrança pagou.
  kind        String
  /// O status como o Asaas o chama: PENDING, CONFIRMED, RECEIVED, OVERDUE, REFUNDED…
  status      String
  /// "PIX" | "CREDIT_CARD". Guardado porque a carência depende dele:
  /// 3 dias no cartão, 2 no Pix.
  billingType String?

  /// Em centavos, como todo dinheiro deste banco.
  valueCents Int

  dueDate DateTime
  paidAt  DateTime?

  /// Links do Asaas: a fatura para pagar e o comprovante depois de paga.
  invoiceUrl String?
  receiptUrl String?

  /// Quando chegou o evento que escreveu esta linha pela última vez.
  ///
  /// É o que torna o espelho **independente de ordem**. `PAYMENT_CONFIRMED` e
  /// `PAYMENT_RECEIVED` chegam quase juntos, e uma retentativa do BullMQ pode
  /// aplicar o primeiro **depois** do segundo: sem esta coluna, o último a
  /// escrever ganharia, e o espelho diria "confirmado" numa cobrança já
  /// recebida. Com ela, evento mais antigo que o último aplicado é descartado.
  ///
  /// A ordem é a de **chegada** e não a de criação no Asaas: é a que vale com o
  /// envio sequencial deles, e é a única que temos sem depender de um campo de
  /// data no corpo.
  lastEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, dueDate])
  @@index([status])
  @@map("invoices")
}

model Workspace {
  /// De quem é esta unidade. Toda workspace tem conta — ver `Account`.
  accountId        String
  creditPurchases  CreditPurchase[]
  notificationLogs NotificationLog[]
  notifications    Notification[]
  termsAcceptances TermsAcceptance[]
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  avatar           String?
  settings         Json? // Tema, idioma, fuso horário

  // Company Details
  cnpj    String? // CNPJ da empresa
  address String? // Endereço completo
  phone   String? // Telefone comercial
  logo    String? // Logo para relatórios

  // The workspace that operates the product itself. Its OWNER administers the
  // platform-wide integration credentials every clinic connects through, so
  // there is no second permission list to keep in sync with the roles.
  isPlatform Boolean @default(false)

  /// Quando a unidade foi tirada do ar, se foi.
  ///
  /// Suspender não apaga nada: a clínica sai do ar — ninguém entra, os agentes
  /// são pausados e os números desconectados — e agenda, pacientes, conversas e
  /// histórico continuam guardados. É o que permite devolver a vaga contratada
  /// sem destruir a clínica que a ocupava, e reativar é voltar isto a nulo.
  ///
  /// A primeira unidade da conta nunca é suspensa: ela é a conta. Quem quer
  /// encerrar tudo cancela a assinatura.
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  account         Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  users           WorkspaceUser[]
  invites         Invite[]
  agents          Agent[]
  outcomeReasons  DealOutcomeReason[]
  contacts        Contact[]
  deals           Deal[]
  conversations   Conversation[]
  knowledgeGaps   KnowledgeGap[]
  evaluationCases EvaluationCase[]
  evaluations     Evaluation[]
  gapSuggestions  GapSuggestion[]
  integrations    Integration[]
  departments     Department[]
  tags            Tag[]
  products        ProductService[]
  activities      Activity[]
  pipelineStages  PipelineStage[]
  pipelines       Pipeline[]
  quickResponses  QuickResponse[]
  usageLogs       UsageLog[]
  origins         Origin[]
  medias          Media[]
  customFields    CustomFieldDefinition[]

  /// O que a clínica deixou ligado: boletim diário, hora dele, tarefa de
  /// retomada. JSON porque a lista cresce a cada camada de automação, e uma
  /// coluna por chave viraria uma migração por melhoria.
  automations        Json?
  professionals      Professional[]
  scheduleExceptions ScheduleException[]
  contactLists       ContactList[]
  whatsappTemplates  WhatsAppTemplate[]
  broadcasts         Broadcast[]
  recados            TeamMessage[]
  emailSenders       EmailSender[]
  emailTemplates     EmailTemplate[]
  funnels            Funnel[]
  leadForms          LeadForm[]
  leadFormSubmissions LeadFormSubmission[]

  @@index([accountId])
  @@map("workspaces")
}

model WorkspaceUser {
  id          String  @id @default(cuid())
  workspaceId String
  userId      String
  role        String // OWNER, ADMIN, GESTOR, ATENDENTE
  canTransfer Boolean @default(false)
  isActive    Boolean @default(true)

  /// Esta pessoa entra na distribuição de conversas?
  ///
  /// **É marca por pessoa, e o papel só define o padrão** (GESTOR e ATENDENTE
  /// ligados; OWNER e ADMIN desligados). A regra "só ATENDENTE recebe" quebraria
  /// a clínica de uma pessoa só, em que o dono é o atendente: ninguém seria
  /// elegível e **toda** conversa ficaria sem responsável.
  ///
  /// O default `true` vale para quem já existe — a migração desliga OWNER e
  /// ADMIN em seguida, que é o padrão certo para eles.
  recebeConversas Boolean @default(true)

  /// `disponivel | ocupado | ausente`.
  ///
  /// **Ocupado e ausente são idênticos para a distribuição** — nenhum dos dois
  /// recebe. A diferença é para a equipe saber se vale chamar no particular, e a
  /// tela precisa dizer isso: quem lê "ocupado" supõe que recebe *menos*, e
  /// recebe *nada*.
  ///
  /// Mora aqui e não em `User` porque na Multiclínica a mesma pessoa pode estar
  /// disponível numa unidade e não na outra.
  ///
  /// Só é **lido** quando `distribuicao.soDisponiveis` está ligado na política
  /// do workspace: empresa sem turno distribui de madrugada de propósito, para
  /// quem chega de manhã já ter carteira.
  status String @default("ausente")

  /// Quando o status mudou. Serve ao histórico e à tela, não à queda
  /// automática — para isso, ver `ultimaAtividadeEm`.
  statusEm DateTime @default(now())

  /// Última ação desta pessoa na aplicação.
  ///
  /// **A queda para ausente é derivada daqui, não escrita.** "Status antigo"
  /// não serve como sinal: quem trabalha há duas horas tem o status antigo e
  /// está presente. O que diz presença é atividade.
  ///
  /// Derivar em vez de gravar o flip evita um job de fundo e deixa a regra
  /// **pura** — `estaDisponivel` decide com a data na mão, e o teste prova sem
  /// banco. O único custo é tocar esta coluna nas rotas, e com folga: só é
  /// reescrita quando já está velha (ver `getWorkspaceMember`).
  ///
  /// Não confundir com presença por sessão, descartada no desenho: sessão dura
  /// 7 dias e não diz quem está na mesa. Isto é ação real no sistema.
  ultimaAtividadeEm DateTime?

  /// Minutos de inatividade até cair para ausente. Nulo = o padrão da conta.
  ///
  /// **Era só da conta** (`Workspace.automations.minutosParaAusente`), e o
  /// Andre apontou que é atributo de pessoa: a recepcionista que atende balcão
  /// fica minutos fora do sistema sem estar ausente; quem só trabalha na tela
  /// não.
  ///
  /// **Mas é configuração da gestão, não da pessoa** — e essa parte é a que
  /// importa. Isto entra em `estaDisponivel`, que decide quem recebe conversa:
  /// se cada um escolhesse o seu, quem pusesse 5 minutos receberia menos
  /// trabalho que quem pusesse 120. Vira alavanca de carga com cara de
  /// preferência. Por isso mora ao lado de `recebeConversas` e `canTransfer`,
  /// no painel que só a gestão edita.
  ///
  /// Nulo e não um número: o padrão continua sendo o da conta, então mexer no
  /// valor da conta continua valendo para quem não tem o seu — e ninguém
  /// precisa preencher 20 fichas para mudar uma política.
  minutosParaAusente Int?
  permissions        Json? // Granular permissions
  createdAt          DateTime @default(now())

  workspace   Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// De quais departamentos esta pessoa é — podem ser vários.
  ///
  /// Era uma coluna `departmentId`, um departamento por pessoa, e isso não
  /// respondia à pergunta que a clínica faz: "hoje a Recepção precisa cobrir o
  /// Comercial". Com um só, a única saída era mover a pessoa de departamento e
  /// lembrar de mover de volta.
  departments WorkspaceUserDepartment[]

  @@unique([workspaceId, userId])
  @@map("workspace_users")
}

/// De quais departamentos um membro é.
///
/// Tabela explícita, no mesmo molde de `ConversationTag` e `ContactTag`, em vez
/// da relação implícita do Prisma: o nome da tabela aparece em migração e em
/// consulta crua, e `_DepartmentToWorkspaceUser` não se lê.
///
/// **É o único botão da visibilidade de conversa.** O papel decide se a pessoa
/// vê o próprio trabalho ou o de todos; esta tabela decide de quais filas. Não
/// existe um terceiro ajuste, e tirar alguém de um departamento é como se tira
/// o acesso à fila dele.
model WorkspaceUserDepartment {
  workspaceUserId String
  departmentId    String

  workspaceUser WorkspaceUser @relation(fields: [workspaceUserId], references: [id], onDelete: Cascade)
  department    Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([workspaceUserId, departmentId])
  @@index([departmentId])
  @@map("workspace_user_departments")
}

// ============================================
// 2. QUICK RESPONSES
// ============================================

model QuickResponse {
  id          String @id @default(cuid())
  workspaceId String

  command  String // Ex: /saudacao, /precos
  text     String  @db.Text
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, command])
  @@index([workspaceId])
  @@map("quick_responses")
}

// ============================================
// 3. AI AGENTS & RULES
// ============================================

model Agent {
  /// Set when a downgrade pushed this agent past the plan's allowance. The user
  /// cannot switch it back on; only a plan that fits releases it.
  pausedByLimit Boolean @default(false)
  id            String  @id @default(cuid())
  workspaceId   String

  /// A versão publicada do treinamento. Zero quer dizer "nunca publicou".
  ///
  /// É **do agente** e não de cada documento: os sete se contradizem entre si por
  /// desenho (há precedência declarada), e comparar "Serviços v3 com Processo v1"
  /// compararia um agente que nunca existiu.
  trainingVersion Int     @default(0)
  name            String
  description     String?
  avatar          String?

  // AI Configuration
  llmProvider  String // "openai" — único provedor do MVP; ver src/types/llm.ts
  llmModel     String // ver OPENAI_MODELS em src/lib/llm/models.ts
  systemPrompt String @db.Text
  temperature  Float  @default(0.7)

  // PERFIL
  initialMessage String? @db.Text // Mensagem inicial do agente
  agentFunction  String? // "sdr_atendimento" | "vendas" | "suporte"

  // TRABALHO
  jobDescription     String? @db.Text // Funções e atribuições
  companyName        String? // Nome da empresa
  companySector      String? // Setor da empresa
  companyWebsite     String? // Site da empresa — só o endereço; o conteúdo das páginas vive em KnowledgeDocument
  companyDescription String? @db.Text // Descrição da empresa
  /// Logradouro completo da unidade que este agente atende.
  ///
  /// Fica no agente, não no workspace, porque a clínica com duas unidades usa um
  /// agente por unidade: o endereço é o que as distingue para o paciente.
  companyAddress     String? @db.Text

  // Visual & Tone
  primaryColor String  @default("#3B82F6")
  voiceTone    String? // "formal", "casual", "friendly"
  language     String  @default("pt-BR")
  /// O fuso da unidade, usado para dizer ao agente que horas são agora.
  ///
  /// Era fixo no código: certo para a maior parte do Brasil, errado por uma hora
  /// em Manaus e por duas em Rio Branco — e o erro aparece justamente nas
  /// respostas sobre horário de atendimento.
  timezone     String  @default("America/Sao_Paulo")

  // VOZ (para futuro)
  voiceEnabled  Boolean @default(false)
  voiceModel    String? // Modelo de voz
  voiceTraining String? @db.Text // Instruções de treinamento

  // VISUAL
  visualConfig Json? // { userMessageColor, userFontColor, agentMessageColor, agentFontColor }

  // Knowledge Base
  knowledgeBase Json? // Funções, FAQs, dados da empresa

  // PREFERÊNCIAS DA CONVERSA (Menu Comandos de Intenção)
  preferences Json? // { showTypingIndicator, responseSpeed, keepContext, useEmojis, allowManualTakeover, restrictTopics, interactionLimit }

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules            AgentRule[]
  conversations    Conversation[]
  knowledgeGaps    KnowledgeGap[]
  trainingVersions AgentTrainingVersion[]
  evaluationCases  EvaluationCase[]
  evaluations      Evaluation[]
  gapSuggestions   GapSuggestion[]
  knowledgeDocs    KnowledgeDocument[]
  trainingDocs     AgentTrainingDoc[]
  integrations     AgentIntegration[]
  webhooks         AgentWebhook[]
  customFields     AgentCustomField[]
  usageLogs        UsageLog[]
  trainingAddons   TrainingAddon[]

  @@index([workspaceId])
  @@map("agents")
}

model AgentRule {
  id          String  @id @default(cuid())
  agentId     String
  name        String
  description String?

  // Condição → Ação (JSON/YAML)
  conditions Json // Array de { type, operator, value }
  actions    Json // Array de { type, params }

  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_rules")
}

// Integrações de canais do agente
model AgentIntegration {
  /// The connected number, lifted out of `config` so it can be unique across
  /// every workspace: a number belongs to one workspace at a time, which is what
  /// stops trials being chained with the same line.
  phoneNumber String?
  id          String  @id @default(cuid())
  agentId     String

  // Tipo de canal
  channel String // "site" | "whatsapp_qr" | "whatsapp_business" | "instagram" | "telegram" | "mercadolivre"

  /// O nome que a clínica dá a esta linha — "Unidade Centro", "Ortodontia".
  ///
  /// Existe porque um agente pode atender por vários números, e a tela precisa
  /// dizer por qual deles a conversa chegou. Vazio, o número faz esse papel.
  label String?

  /// A chave pública do widget do site.
  ///
  /// Vai dentro da página da clínica, à vista de qualquer visitante — então ela
  /// identifica, e **não autoriza nada além de iniciar uma conversa**. Tudo o
  /// que ela permite é o que um visitante pode fazer: abrir um atendimento e
  /// falar nele. Ler conversa de outra pessoa depende do id de sessão, que é
  /// sorteado por visitante e nunca sai do navegador dele.
  ///
  /// Só existe em `channel = "site"`.
  publicKey String?

  /// De quem é a fila desta linha.
  ///
  /// É o que dá escopo à caixa de entrada: a guia "Em espera" mostrava toda
  /// conversa sem responsável a todo mundo, então quem atende a unidade do
  /// Centro lia o tempo todo a fila da Barra. Com a linha ligada a um
  /// departamento, o atendente daquele departamento vê a fila dele; a gestão
  /// continua vendo tudo.
  ///
  /// Nulo é a fila geral da clínica, visível a todos — é também o estado de
  /// quem não usa departamentos, para quem nada muda.
  departmentId String?

  /// Quem recebe as conversas **desta** linha. Nulo é "como na conta".
  ///
  /// A política de distribuição era só da clínica, em `Workspace.automations`:
  /// uma estratégia para todos os números. O pedido do Andre (26/11/2026) não
  /// cabe nisso — um número de WhatsApp entregue direto a um atendente, ao lado
  /// de outro número que roda o rodízio normal.
  ///
  /// Guarda uma política **inteira** (`estrategia`, `soDisponiveis` e, em
  /// `fixo`, a pessoa), validada por `lerPolitica` em
  /// `lib/conversas/distribuicao.ts` — a mesma função que lê a da conta, para
  /// que os dois depósitos não divirjam. Quando preenchida, substitui a da
  /// conta por completo; não se mistura campo a campo, que produziria
  /// combinações que nenhuma tela sabe mostrar.
  ///
  /// **Nulo é o estado de toda linha existente**, e por isso esta migração não
  /// muda o comportamento de ninguém: sem política própria, vale a da clínica,
  /// exatamente como antes. Mesma convenção de `departmentId` (nulo é fila
  /// geral) e de `WorkspaceUser.minutosParaAusente` (nulo é o padrão do
  /// sistema).
  ///
  /// JSON e não colunas pela razão de sempre: é ajuste de operação, muda numa
  /// tarde, e uma coluna por chave viraria uma migração por melhoria.
  distribuicao Json?

  /// A origem que esta linha semeia na ficha de quem escreve por ela.
  ///
  /// É o que separa duas linhas do **mesmo** canal: o WhatsApp QR da V4 e o do
  /// Nando são os dois `whatsapp_qr`, e o que diz qual agência trouxe o
  /// paciente não é o canal nem a conversa — é o número para onde o anúncio
  /// mandou. Com a linha semeando, a atribuição acontece sem ninguém digitar.
  ///
  /// Nula na clínica de um número só, onde não há o que distinguir. Só semeia
  /// ficha nova: a origem de quem já é paciente não se reescreve porque ele
  /// voltou por outro anuncio.
  defaultOriginId String?
  /// A mídia que esta linha semeia — a campanha ou a peça que mandou o
  /// paciente para cá. Fecha o par com `defaultOriginId`: origem é de quem veio
  /// o lead, mídia é o detalhe dentro dela (PRODUCT.md §10).
  defaultMediaId  String?

  // Status da conexão
  status String @default("disconnected") // "connected" | "disconnected" | "pending" | "error"

  // Configurações específicas do canal (JSON)
  config Json? // { qrCode, sessionId, accessToken, phoneNumber, etc }

  // Metadados
  connectedAt  DateTime?
  lastActiveAt DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent             Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultOrigin     Origin?            @relation(fields: [defaultOriginId], references: [id], onDelete: SetNull)
  defaultMedia      Media?             @relation(fields: [defaultMediaId], references: [id], onDelete: SetNull)
  conversations     Conversation[]
  whatsappTemplates WhatsAppTemplate[]
  broadcasts        Broadcast[]

  /// Sem `@@unique([agentId, channel])`: um agente atende por N números.
  ///
  /// A restrição vinha de quando a tela oferecia um cartão por canal e um botão
  /// Conectar — um número por agente, por construção. Ela é o que impedia a
  /// clínica de pôr o mesmo agente em duas linhas (duas unidades, dois
  /// consultórios), e o teto real é o do plano, contado por workspace em
  /// `canConnectWhatsApp`, não um índice no banco.
  @@index([agentId])
  @@index([agentId, channel])
  @@index([departmentId])
  @@index([defaultOriginId])
  @@index([defaultMediaId])
  @@index([publicKey])
  @@map("agent_integrations")
}

// Webhooks do agente
model AgentWebhook {
  id      String @id @default(cuid())
  agentId String

  // Configuração
  name String
  type String // "inbound" | "outbound"
  url  String

  // Autenticação
  authType   String? // "none" | "basic" | "bearer" | "api_key"
  authConfig Json? // { username, password } | { token } | { key, header }

  // Status e saúde
  status          String    @default("active") // "active" | "inactive" | "error"
  healthScore     Int       @default(100) // 0-100
  lastTriggeredAt DateTime?
  lastErrorAt     DateTime?
  errorCount      Int       @default(0)

  // Eventos que disparam (para outbound)
  events Json? // ["message.received", "conversation.started", etc]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("agent_webhooks")
}

// Campos customizados do agente
model AgentCustomField {
  id      String @id @default(cuid())
  agentId String

  // Nome/Variável (ex: {{customer_name}})
  variable String

  // Tipo do campo
  fieldType String // "text" | "number" | "date" | "boolean" | "select"

  // Configurações do campo (opções para select, etc)
  config Json?

  // Valor padrão
  defaultValue String?

  // Ordem de exibição
  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, variable])
  @@index([agentId])
  @@map("agent_custom_fields")
}

// ============================================
// 3. CRM - CONTACTS & DEALS
// ============================================

model Contact {
  /// Quando o paciente pediu para parar de receber mensagens automáticas.
  ///
  /// Fica no paciente, não na conversa: um fio novo amanhã continua
  /// respeitando. A equipe pode escrever normalmente — o que para é o envio
  /// automático.
  autoMessagesPausedAt DateTime?

  /// Quando esta pessoa saiu do e-mail — e **só** do e-mail.
  ///
  /// Coluna separada de `autoMessagesPausedAt` de propósito: descadastrar-se de
  /// uma campanha de e-mail não é pedir para o atendimento por WhatsApp parar, e
  /// tratar como a mesma coisa calaria o canal onde a clínica realmente atende.
  /// A recíproca também vale: quem pediu "pare" no WhatsApp não pediu para sair
  /// da newsletter.
  ///
  /// Escrito por três caminhos, e nenhum deles é a equipe: o link de
  /// descadastro, o botão nativo do cliente de e-mail (evento `Subscription` do
  /// SES) e o recibo de reclamação de spam ou bounce duro. Opt-out é decisão de
  /// quem recebe — a tela mostra, não edita.
  emailOptOutAt DateTime?

  id          String @id @default(cuid())
  workspaceId String

  // Basic Info
  name   String?
  email  String?
  phone  String?
  avatar String?

  /// Quem é este paciente no Instagram — o IGSID.
  ///
  /// Coluna própria, e **não** o `phone`: o id que o Direct manda é um número
  /// de dezessete dígitos escopado ao nosso aplicativo, não um telefone.
  /// Guardá-lo em `phone` o faria aparecer formatado como celular na ficha,
  /// entrar na busca por telefone e passar por `phoneVariants`, que inventa
  /// variação de nono dígito em cima dele.
  ///
  /// Nulo para quem nunca escreveu pelo Instagram, que é a maioria. O índice
  /// único ignora nulos no Postgres, então conviver com milhares deles é
  /// exatamente o que já acontece com `phone`.
  ///
  /// Uma ficha pode ter os dois: o mesmo paciente que escreveu pelo WhatsApp e
  /// depois pelo Direct. Unificar as duas é decisão da clínica, não nossa — não
  /// há como saber que são a mesma pessoa sem ela dizer.
  instagramId String?

  /// Quem é este paciente para o WhatsApp quando ele o endereça por **LID**.
  ///
  /// Coluna própria pelo mesmo motivo de `instagramId`, e por um prejuízo já
  /// medido: o LID é um identificador de conta que **não é telefone**, e o
  /// inbound o gravava em `phone`. Catorze fichas da Implante Já nasceram com
  /// um número de catorze ou quinze dígitos no lugar do celular, e as dezoito
  /// respostas que a clínica mandou para elas falharam todas — o envio monta
  /// `<numero>@s.whatsapp.net`, e aquele número não existe em lugar nenhum.
  /// Eram leads de anúncio, e nenhum foi respondido.
  ///
  /// Guardá-lo aqui resolve as duas metades: o fio continua tendo dono (o LID é
  /// a única identidade que o evento traz quando o telefone não vem no par), e
  /// nada mais o confunde com telefone — não é formatado como celular na ficha,
  /// não entra na busca por telefone, não passa por `phoneVariants` e não é
  /// usado como destino de envio.
  ///
  /// Uma ficha pode ter os dois. É o caso bom: `telefoneAlternativoNoInfo`
  /// recupera o telefone do envelope e grava os dois juntos, e é esse par que
  /// permite reencontrar a mesma pessoa quando um evento futuro vier só com o
  /// LID.
  lid String?

  notes String? @db.Text // Observações

  // Custom Fields
  customFields Json?

  /// Como esta ficha nasceu: `manual`, `import`, `ligacao` ou `inbound`.
  ///
  /// Era `source`, e guardava três coisas na mesma coluna — o canal
  /// (`whatsapp`, `instagram`, `site`), o nascimento da ficha (`manual`,
  /// `import`) e a origem comercial (`google`, `facebook`). A tela chamava
  /// tudo de "Origem", então "WhatsApp" aparecia como resposta para "de onde
  /// vem nosso paciente" — que é o canal, e não responde nada.
  ///
  /// Aqui fica só o nascimento. O canal se deriva da conversa (`channel` e a
  /// linha); a origem comercial é `originId`.
  createdVia String?

  /// A origem comercial — o que fez o paciente escrever.
  ///
  /// Semeada pela linha por onde ele chegou, quando ela tem dono conhecido
  /// (ver `AgentIntegration.defaultOriginId`), e editável na ficha depois:
  /// ninguém **detecta** origem, alguém informa.
  originId String?

  lastContactAt DateTime?
  /// Texto já normalizado para busca — minúsculo e sem acento.
  ///
  /// Coluna GERADA pelo Postgres (ver a migração
  /// `20261010100000_accent_insensitive_search`): existe aqui para que o Prisma
  /// possa filtrar por ela, e **nunca deve ser escrita** — o banco recusa. É o
  /// que faz "André" e "andre" localizarem a mesma pessoa sem SQL cru em cada
  /// rota de busca.
  searchText    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  origin              Origin?              @relation(fields: [originId], references: [id], onDelete: SetNull)
  conversations       Conversation[]
  deals               Deal[]
  activities          Activity[]
  tags                ContactTag[]
  listMemberships     ContactListMember[]
  broadcastRecipients BroadcastRecipient[]
  funnelRuns          FunnelRun[]
  formSubmissions     LeadFormSubmission[]

  @@unique([workspaceId, phone])
  @@unique([workspaceId, instagramId])
  @@unique([workspaceId, lid])
  @@index([workspaceId])
  @@index([phone])
  @@index([instagramId])
  @@index([lid])
  @@index([email])
  @@index([originId])
  @@map("contacts")
}

model Deal {
  id          String  @id @default(cuid())
  workspaceId String
  contactId   String?
  userId      String? // Deal owner
  originId    String?
  mediaId     String?

  title    String
  value    Float?
  currency String @default("BRL")
  status   String @default("open") // "open", "won", "lost"

  /// O desfecho, quando houve: por que ganhou ou perdeu.
  ///
  /// Era `lossReason` com sete códigos fixos no app e nenhum equivalente para
  /// ganho. Agora é referência para uma lista que a clínica alimenta, e o mesmo
  /// campo serve os dois lados — quem fecha escolhe o lado primeiro, e a lista
  /// se filtra por ele.
  outcomeReasonId String?
  outcomeNotes    String? @db.Text
  /// A fase em que estava ao fechar. "Perdeu na Proposta" é o dado que diz onde
  /// o funil vaza, e sem isto ele se perde no instante do fechamento.
  closedStageId   String?
  /// O que de fato fechou. Proposta de 42 mil fechada em 38 é a diferença entre
  /// o que o funil mostra e o que entrou no caixa.
  closedValue     Float?

  // Pipeline
  stageId     String
  probability Int    @default(0) // 0-100

  // Tracking (JSON: contact1/2/3, scheduled, attended, rework)
  trackingData Json?

  // Metadata
  notes      String?   @db.Text
  closedAt   DateTime?
  /// Texto já normalizado para busca — minúsculo e sem acento.
  ///
  /// Coluna GERADA pelo Postgres (ver a migração
  /// `20261010100000_accent_insensitive_search`): existe aqui para que o Prisma
  /// possa filtrar por ela, e **nunca deve ser escrita** — o banco recusa. É o
  /// que faz "André" e "andre" localizarem a mesma pessoa sem SQL cru em cada
  /// rota de busca.
  searchText String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  origin        Origin?            @relation(fields: [originId], references: [id], onDelete: SetNull)
  media         Media?             @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  stage         PipelineStage      @relation("DealCurrentStage", fields: [stageId], references: [id])
  /// Relação nomeada: o negócio aponta para duas etapas — onde está e, se
  /// fechou, de onde saiu.
  closedStage   PipelineStage?     @relation("DealClosedStage", fields: [closedStageId], references: [id], onDelete: SetNull)
  activities    Activity[]
  stageEntries  DealStageEntry[]
  outcomeReason DealOutcomeReason? @relation(fields: [outcomeReasonId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([stageId])
  @@index([status])
  @@index([contactId, status])
  @@index([userId])
  @@index([originId])
  @@index([mediaId])
  /// A varredura do cron de follow-up, que procura por fase e estado.
  ///
  /// Criado em `20261011090000_follow_up_engine` e **não declarado aqui** por
  /// dois meses: existia no banco, servia o cron, e não aparecia no schema. O
  /// efeito era invisível até alguém criar um banco novo a partir dele — aí o
  /// cron varria a tabela inteira em sequencial, e o desempenho de
  /// desenvolvimento divergia do de produção sem nada explicar por quê.
  ///
  /// `map` preserva o nome que o banco já tem: sem ele o Prisma chamaria o
  /// índice de `deals_workspaceId_status_stageId_idx` e passaria a querer
  /// derrubar o existente para criar um idêntico com outro nome.
  @@index([workspaceId, status, stageId], map: "deals_workspace_status_stage_idx")
  @@map("deals")
}

/// Um funil de vendas: a lista ordenada de fases em que um negócio anda.
///
/// ## Por que existe, se a etapa já tinha `workspaceId`
///
/// Até 20/11/2026 o funil era implícito — "a lista ordenada de `PipelineStage`
/// da unidade" — e por isso só podia haver um. A clínica com dois produtos de
/// ciclo diferente (avaliação de um lado, plano de tratamento de outro) punha
/// os dois no mesmo trilho e as fases de um não diziam nada ao outro. Pedido
/// do Andre em 20/11/2026: cadastrar outros funis, escolher em Negócios qual se
/// trabalha, e marcar **um** como padrão.
///
/// ## O padrão é o do atendimento
///
/// Só um por unidade tem `isDefault`, e é esse que o módulo de atendimento usa
/// inteiro: o negócio que nasce da primeira mensagem entra na primeira fase
/// dele, o cartão e o filtro da caixa de entrada leem a fase dele, o agente de
/// IA só move negócio nele, e o painel mostra a jornada dele. Os outros funis
/// são de trabalho manual em Vendas → Negócios. Um negócio pertence a um funil
/// pela fase em que está — não há coluna duplicada aqui para divergir.
///
/// Um contato tem **no máximo um negócio aberto por funil** (a regra 1:1 virou
/// 1:1 por funil): é o que deixa o mesmo paciente ter uma avaliação em
/// andamento e um plano em negociação sem que um esconda o outro.
model Pipeline {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  /// O funil do atendimento. Exatamente um por unidade — a rota troca os dois
  /// na mesma transação, e `funilPadrao()` conserta se a invariante escapar.
  isDefault   Boolean @default(false)
  /// A ordem no seletor de Negócios. Não é prioridade de nada.
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@index([workspaceId])
  @@map("pipelines")
}

model PipelineStage {
  /// Quem aperta enviar nesta fase: `off`, `draft` ou `send`.
  ///
  /// `off` cobra só com tarefa. `draft` escreve a mensagem e deixa para alguém
  /// aprovar — é o modo ensaio, e é por onde toda clínica deveria passar antes
  /// de soltar. `send` manda sozinho a quem tem WhatsApp, respeitando os freios
  /// de `auto-follow-up`.
  autoSend String @default("off")

  /// Dias sem retorno marcado até o sistema cobrar uma retomada.
  ///
  /// `null` significa "esta fase não cobra" — útil onde a espera não é da
  /// clínica, como um retrabalho parado no laboratório. O limite é por fase
  /// porque cobrar em dois dias no primeiro contato e em dez no comparecimento
  /// não é a mesma coisa.
  followUpDays Int?

  id          String @id @default(cuid())
  workspaceId String
  /// O funil desta fase.
  ///
  /// Nulo só na janela do deploy: a migração que criou `pipelines` adotou toda
  /// fase existente no funil padrão da unidade, e todo caminho que cria fase
  /// passa o funil. Fica opcional porque `SET NOT NULL` numa coluna nova
  /// quebraria o código velho que ainda insere fase sem ela enquanto o publish
  /// não termina (ver `lint-migracoes`); `funilPadrao()` adota a órfã que
  /// escapar por essa janela. O aperto para `NOT NULL` é a fase contract, num
  /// deploy seguinte.
  pipelineId  String?
  name        String
  order       Int
  color       String @default("#6B7280")

  deals       Deal[]           @relation("DealCurrentStage")
  closedDeals Deal[]           @relation("DealClosedStage")
  entries     DealStageEntry[]

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

/// Cada vez que um negócio entra numa etapa.
///
/// `Deal.stageId` é a posição atual; isto é o percurso. Antes desta tabela a
/// pergunta "quando este negócio chegou em Proposta?" não tinha resposta no
/// banco, e a jornada do paciente vivia num JSON de seis marcos fixos — um
/// vocabulário diferente do funil que a clínica configurou. Agora há um só:
/// as etapas da clínica, e a data e a nota de cada passagem por elas.
///
/// Voltar atrás acrescenta uma entrada em vez de apagar uma, então a segunda
/// passagem por uma etapa é um registro próprio e a primeira continua existindo.
/// Por que um negócio foi ganho ou perdido, na lista da própria clínica.
///
/// Os motivos de perda viviam fixos no código — sete, com emoji — e motivo de
/// ganho não existia. Uma clínica que fecha por indicação e outra que fecha por
/// preço competitivo precisam de listas diferentes, e nenhuma das duas cabe num
/// enum do app. `kind` separa os dois lados porque "preço alto" não é motivo de
/// ganho: uma lista única convidaria ao erro no momento mais importante do funil.
model DealOutcomeReason {
  id          String   @id @default(cuid())
  workspaceId String
  /// "won" | "lost"
  kind        String
  name        String
  order       Int      @default(0)
  /// Desativado em vez de apagado: negócio já fechado continua apontando para cá.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]

  @@index([workspaceId, kind, order])
  @@map("deal_outcome_reasons")
}

model DealStageEntry {
  id        String    @id @default(cuid())
  dealId    String
  stageId   String
  /// Quando entrou. Separado de `createdAt` porque a clínica pode corrigir a
  /// data de uma passagem que registrou depois do fato — e **nulo** quando ela
  /// registra a passagem sem saber a data. A passagem existe de qualquer jeito;
  /// é a data que falta.
  enteredAt DateTime? @default(now())
  /// O que aconteceu nesta fase. É a "nota" que a jornada antiga guardava.
  note      String?   @db.Text
  /// Quem moveu. Nulo quando foi uma regra ou o próprio agente.
  userId    String?
  createdAt DateTime  @default(now())

  deal  Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stage PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([dealId, enteredAt])
  @@index([stageId])
  @@map("deal_stage_entries")
}

/// De onde vem o paciente — a origem comercial, não o canal.
///
/// Era a tabela `agencies`, a lista que o Negócio chamava de "Origem", e vivia
/// separada de `Contact.source`, que a ficha do paciente **também** chamava de
/// Origem. Duas listas com o mesmo nome e nenhuma relação: a clínica cadastrava
/// "V4" numa e gravava "facebook" na outra, e nenhum relatório fechava.
///
/// Esta é a lista única, usada pela ficha, pelo negócio e pela linha.
///
/// **Não é canal.** Canal é por onde a mensagem entrou (`whatsapp_qr`,
/// `instagram`) e o sistema grava sozinho; origem é o que fez o paciente
/// escrever, e nenhum canal entrega esse dado.
///
/// Um nível só, de propósito. "Facebook › V4 › campanha" é hierarquia, e
/// hierarquia aqui é uma coluna `parentId` nula a mais no dia em que a clínica
/// precisar comparar canal de aquisição entre unidades — não antes.
model Origin {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]
  contacts  Contact[]
  lines     AgentIntegration[]
  leadForms LeadForm[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("origins")
}

model Media {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals     Deal[]
  /// As linhas que semeiam esta mídia.
  lines     AgentIntegration[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("medias")
}

model Activity {
  /// Criada por automação, não por uma pessoa.
  ///
  /// Serve à etiqueta na tela e ao filtro: tarefa que aparece sem explicação
  /// vira ruído que a equipe aprende a ignorar.
  auto Boolean @default(false)

  id          String  @id @default(cuid())
  workspaceId String
  userId      String?
  contactId   String?
  dealId      String?

  /// Quem executa — o profissional, não o responsável pela tarefa.
  ///
  /// `userId` acima continua sendo "Responsável": quem da equipe cuida disto.
  /// Esta coluna é quem atende o paciente, e é por ela que a agenda filtra.
  professionalId String?

  /// O que vai ser feito, do catálogo de Itens.
  ///
  /// É de onde sai a duração do compromisso — e é o que permite ao agente
  /// reservar o tempo certo em vez de chutar.
  productServiceId String?

  type        String // "call", "meeting", "email", "task", "note", "videocall", "followup"
  title       String
  description String? @db.Text

  // Scheduling
  dueDate     DateTime?
  startTime   String? // "09:00"
  endTime     String? // "10:00"
  completedAt DateTime?

  // Reminders
  reminderMinutes Int? // null = no reminder, 15, 30, 60, 1440 (1 day)
  reminderSentAt  DateTime? // track if reminder was already sent

  // Recurrence
  recurrenceType     String? // "daily", "weekly", "monthly", "yearly"
  recurrenceEnd      DateTime?
  recurrenceParentId String? // link to parent recurring activity
  recurrenceParent   Activity?  @relation("ActivityRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren Activity[] @relation("ActivityRecurrence")

  // Google Calendar sync
  googleCalendarEventId String? // Google Calendar event ID for sync

  /// Texto já normalizado para busca — minúsculo e sem acento.
  ///
  /// Coluna GERADA pelo Postgres (ver a migração
  /// `20261010100000_accent_insensitive_search`): existe aqui para que o Prisma
  /// possa filtrar por ela, e **nunca deve ser escrita** — o banco recusa. É o
  /// que faz "André" e "andre" localizarem a mesma pessoa sem SQL cru em cada
  /// rota de busca.
  searchText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal           Deal?           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  professional   Professional?   @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  productService ProductService? @relation(fields: [productServiceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@index([dueDate])
  @@index([recurrenceParentId])
  @@index([professionalId])
  @@map("activities")
}

// ============================================
// 4. MESSAGING & CONVERSATIONS
// ============================================

model Conversation {
  /// The last automatic courtesy notice sent to the patient, and why. Keeps the
  /// "one per conversation" rule honest: a handoff notice must not repeat on
  /// every message, but a different situation later may warrant a new one.
  autoNoticeAt   DateTime?
  autoNoticeKind String? // "out_of_credits" | "read_only"
  id             String    @id @default(cuid())
  workspaceId    String
  contactId      String
  agentId        String?

  channel   String // "whatsapp", "instagram", "web"
  channelId String? // External ID (WhatsApp conversation ID)

  /// Quem é o visitante, do lado do navegador dele.
  ///
  /// Sorteado quando o widget abre e guardado no `localStorage` do visitante. É
  /// o que permite devolver a conversa dele — e só a dele — sem login: a chave
  /// pública da página identifica a clínica, esta identifica a pessoa.
  ///
  /// Só existe em conversa de `channel = "web"`.
  visitorKey String?

  /// Por qual linha esta conversa entrou.
  ///
  /// O fio era identificado por workspace + paciente, e só: um paciente que
  /// escrevesse para dois números da mesma clínica caía no mesmo fio, e a
  /// resposta saía pela linha que o `findFirst` devolvesse primeiro — podia ser
  /// a outra. Com a linha gravada, cada fio responde por onde chegou.
  ///
  /// Nulo quando não há linha: conversa aberta pela recepção (intake) antes de
  /// o paciente escrever, e o histórico anterior a esta coluna cuja linha não
  /// deu para deduzir. `SetNull` porque remover uma linha não pode levar o
  /// histórico com ela.
  integrationId String?

  status     String  @default("active") // "active", "closed", "snoozed"
  assignedTo String? // User ID

  /// O portão: **a IA ou a equipe?** `"bot"` ou `"humano"`.
  ///
  /// Ideia do Andre, e é ela que desfaz o nó em que `assignedTo` respondia duas
  /// perguntas de uma vez. Hoje a coluna "Em espera" é `assignedTo IS NULL`, o
  /// que faz dela "sem responsável" com nome de "aguardando" — e as duas coisas
  /// não são a mesma: a conversa pode ter responsável e ainda estar com a IA,
  /// que é o caso normal de um lead que acabou de chegar.
  ///
  /// Com o portão explícito, `assignedTo` volta a responder **uma** pergunta
  /// (quem é a pessoa) e esta responde a outra (quem está conduzindo). A lista
  /// agrupa por aqui — "Com a IA" / "Com a equipe" — e o recorte de quem é a
  /// pessoa vira o seletor `Ver`.
  ///
  /// **Muda por gesto de gente, nunca por automação.** Põem `"humano"`: assumir,
  /// transferir, responder pela tela, o registro da recepção e a entrega do
  /// agente à equipe (`servicos/entrega.ts`) — nessa última a conversa fica
  /// `humano` **sem responsável**, que é a fila de onde se puxa trabalho.
  /// Voltam a `"bot"`: devolver à IA, reabrir, e o paciente voltar a escrever
  /// depois de finalizada.
  ///
  /// Responder pela tela está nessa lista de propósito: é o gesto de assumir, e
  /// o mais usado de todos. O que **não** mexe aqui é a nota interna — comentar
  /// não assume, e antes assumia (ver `api/conversations/[id]/messages`).
  ///
  /// Nasce `"bot"` porque é o estado de quem acabou de chegar, e porque assim o
  /// código anterior à coluna continua correto sem ler nada disto.
  atendidaPor String @default("bot")

  /// Quando o responsável atual recebeu esta conversa. **É o relógio do rodízio.**
  ///
  /// A estratégia escolhe quem recebeu há mais tempo — `max(ownerAssignedAt)`
  /// mais antigo entre os elegíveis, e quem nunca recebeu vem primeiro. É round
  /// robin **sem ponteiro**: não há cursor para corromper, e entra ou sai gente
  /// da equipe sem a fila ficar enviesada.
  ownerAssignedAt DateTime?

  /// Como este dono foi escolhido: `manual | rodizio | balanceado | regra |
  /// recepcao`. Serve ao suporte, que precisa responder "por que caiu para
  /// mim?" sem ler código.
  ownerSource String?

  /// Quando esta conversa foi entregue a gente, e por quê.
  ///
  /// **`assignedTo` responde a outra pergunta.** Ele significa "um humano está
  /// atendendo agora", e é o mutex que cala o agente. Mas a regra `notify_human`
  /// sem destino e o teto de interações entregavam a conversa deixando
  /// `assignedTo` nulo — e o agente voltava a responder na mensagem seguinte,
  /// por cima de uma entrega já anunciada ao paciente.
  ///
  /// `handoffAt` é o que torna a entrega verdadeira mesmo sem responsável. É
  /// lido por `isHumanHandled` junto de `assignedTo`, e **limpo** nos mesmos
  /// três pontos que limpam o responsável: devolver ao bot, reabrir, e o
  /// paciente que volta a escrever depois de finalizada. Sem a limpeza, uma
  /// entrega calaria o agente para aquele paciente para sempre.
  ///
  /// `handoffReason` é fechado em `MotivoDaEntrega` (ver
  /// `lib/atendimento/escalada.ts`) porque é o que o Andar 3 da medição agrupa:
  /// "% de conversas escaladas, e por qual motivo".
  handoffAt     DateTime?
  handoffReason String?

  /// Quando esta conversa foi finalizada pela última vez.
  ///
  /// Marca o fim de um atendimento, e é por isso que ela existe: o limite de
  /// respostas do agente conta **por atendimento**, e finalizar a conversa
  /// recomeça a contagem. Sem esta coluna a contagem era vitalícia — a conversa
  /// de um paciente que volta é reaberta, não recriada —, e o agente acabava
  /// mudo para sempre com quem fala muito com a clínica.
  ///
  /// Nula em conversa que nunca foi finalizada. Não é limpa ao reabrir: o que
  /// interessa é a última vez que terminou.
  closedAt DateTime?

  lastMessageAt DateTime?
  lastReadAt    DateTime? // When conversation was last read by any operator

  /// O resumo por IA desta conversa, e até onde ele leu.
  ///
  /// Guardado porque gerar custa crédito do cliente: abrir o painel não pode
  /// cobrar de novo o que já foi pago. `summaryUntilId` é a última mensagem
  /// incluída, e é o que permite dizer "N mensagens novas depois do resumo" em
  /// vez de oferecer um botão que ninguém sabe se vale apertar.
  summaryText    String?   @db.Text
  summaryAt      DateTime?
  summaryUntilId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent       Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  integration AgentIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  /// `assignedTo` é string solta, **sem FK**, por herança — tem mais de vinte
  /// leitores e trocar o tipo é risco sem ganho. Houve uma coluna `ownerId` com
  /// FK ao lado dele, e ela caiu na fase de contract de 2026-11-07: as duas
  /// diziam a mesma coisa, e manter duas é como a tela passou a mostrar uma e o
  /// rodízio a escrever a outra.
  ///
  /// Consequência aceita: quem sai da equipe deixa `assignedTo` apontando para
  /// um id que não existe mais. A conversa continua aparecendo em "Sem
  /// responsável" para a gestão, porque o `JOIN` com `users` não acha ninguém —
  /// e é o mesmo efeito que o `SetNull` da FK antiga dava.
  messages      Message[]
  knowledgeGaps KnowledgeGap[]
  tags          ConversationTag[]
  collaborators ConversationCollaborator[]
  recados       TeamMessage[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([integrationId])
  @@index([visitorKey])
  @@index([status])
  /// O agrupamento da coluna: as três abas são `(status, atendidaPor)`.
  @@index([workspaceId, status, atendidaPor])
  /// Filtrada em dois caminhos quentes: as guias Ativas e Finalizadas do
  /// atendente, que mostram só o que é dele, e o recorte de Pacientes, que
  /// pergunta "tem conversa atribuída a mim?" em toda listagem.
  @@index([assignedTo])
  /// O índice do dono serve a duas leituras quentes: "minhas conversas" na
  /// caixa de entrada e a conta de abertas por pessoa, que é o desempate do
  /// balanceado.
  @@map("conversations")
}

/**
 * O que o agente não soube responder.
 * Uma linha por pergunta que terminou em promessa de confirmação **com busca
 * fraca** — a conjunção dos dois sinais, decidida em `lib/atendimento/escalada.ts`.
 * Existe para o passo 5 do estudo (mineração de lacunas e FAQ sugerida). Sem
 * guardar a pergunta no instante em que ela falha, a mineração teria de
 * redescobri-la relendo conversas inteiras com um modelo — caro, e impreciso
 * justamente nas conversas longas, que são as que mais importam.
 * A conta "quantas lacunas neste atendimento?" roda a cada resposta e é o que
 * decide a escalada: duas no mesmo atendimento entregam a conversa à equipe.
 */
model KnowledgeGap {
  id          String @id @default(cuid())
  workspaceId String
  agentId     String

  /// Nula quando a conversa foi apagada: a lacuna sobrevive ao atendimento, que
  /// é o ponto dela.
  conversationId String?

  /// A fala do paciente que ficou sem resposta.
  question String @db.Text

  /// `automatica` (os dois sinais) ou `ferramenta` (o modelo chamou
  /// `nao_encontrei` sobre material que a busca de fato trouxe). A distinção
  /// importa: a primeira diz "falta documento", a segunda diz "o documento
  /// existe e não foi encontrado" — consertos diferentes.
  source String @default("automatica")

  /// A melhor similaridade da busca, quando houve alguma. Nula quando a busca
  /// não devolveu nada, ou devolveu só acerto lexical sem vetor.
  bestSimilarity Float?
  chunkCount     Int    @default(0)

  /// A qual sugestão esta lacuna foi atribuída pela mineração.
  ///
  /// `SetNull` porque descartar uma sugestão não pode apagar as lacunas: elas são
  /// o registro do que o agente não soube, e continuam valendo para a semana
  /// seguinte. É o mesmo raciocínio que fez a lacuna sobreviver à conversa.
  suggestionId String?

  /// Preenchido pelo passo 5: `nova` | `agrupada` | `aprovada` | `descartada`.
  status    String   @default("nova")
  createdAt DateTime @default(now())

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent        Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  suggestion   GapSuggestion? @relation(fields: [suggestionId], references: [id], onDelete: SetNull)

  @@index([agentId, status, createdAt])
  @@index([agentId, suggestionId])
  @@index([conversationId, createdAt])
  @@map("knowledge_gaps")
}

/**
 * A fila de aprovação da mineração de lacunas.
 * Uma linha por **grupo** de lacunas, não por lacuna. Lista crua é inútil depois
 * da primeira semana: "quanto custa clareamento", "qual o valor do clareamento" e
 * "clareamento é caro?" são três lacunas e **um** documento faltando — e a
 * contagem de demanda, que é o que ordena a fila, ficaria errada por desenho.
 * **A sugestão não traz a resposta.** Ela traz a pergunta bem escrita, os
 * sinônimos, a demanda, e um branco marcado num comentário de HTML. A lacuna
 * existe justamente porque a resposta não está em lugar nenhum do acervo; um
 * modelo que a escrevesse estaria inventando preço, horário ou prazo — e um
 * instrutor aprovando vinte sugestões em sequência transformaria isso em fonte de
 * verdade do agente. Ver `lib/lacunas/rascunho.ts`.
 */
model GapSuggestion {
  id          String @id @default(cuid())
  workspaceId String
  agentId     String

  /// A formulação mais central do grupo. Não a primeira (seria a mais antiga,
  /// por acidente de ordem) nem a mais curta (seria "quanto?").
  question String @db.Text

  /// Quantas lacunas caíram neste grupo. Ordena a fila.
  demand Int @default(1)

  /// `servicos` ou `faq` — só documento de acervo. Documento de modo `prompt`
  /// nunca é alvo: sugestão automática não mexe na precedência do prompt, que é a
  /// parte do sistema em que um erro não tem como ser percebido depois.
  targetSlug String

  /// O texto proposto, com o branco marcado. Aprovar sem preencher não entrega
  /// resposta errada ao modelo — `semComentarios` descarta o marcador antes de o
  /// texto ir para o acervo, e a pergunta volta a aparecer como lacuna.
  draftText String @db.Text

  /// `nova` | `aprovada` | `descartada`.
  status    String    @default("nova")
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  gaps      KnowledgeGap[]

  @@index([agentId, status, demand])
  @@map("gap_suggestions")
}

model Message {
  id             String @id @default(cuid())
  conversationId String

  direction   String // "inbound", "outbound"
  content     String  @db.Text
  contentType String  @default("text") // "text", "image", "audio", "video", "file"
  mediaUrl    String?

  // Reply (quoted message)
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Metadata
  sentBy     String? // "agent" | "human" | user_id
  externalId String? // WhatsApp message ID
  status     String  @default("sent") // "sent", "delivered", "read", "failed"
  isInternal Boolean @default(false) // Internal note (visible only to operators)
  // Texto de uma nota de voz recebida (OpenAI transcribe); null quando indisponível.
  transcript String? @db.Text
  // Reação enviada pela clínica a esta mensagem (um emoji), se houver.
  reaction   String?

  /// Quando quem mandou **apagou** esta mensagem no WhatsApp.
  ///
  /// Apagar no WhatsApp não apaga nada do nosso lado: chega um evento novo
  /// (`protocolMessage` de tipo `REVOKE`) dizendo que aquela mensagem não existe
  /// mais. Sem esta coluna o evento não tinha onde pousar — `decodeMessage` não
  /// reconhecia a chave, caía no "[Tipo de mensagem não suportado]" e o sistema
  /// gravava um balão de erro **novo**, ao lado da original, que continuava
  /// visível. A clínica reportou exatamente isso.
  ///
  /// O conteúdo original **fica na linha**, e isto é escolha, não descuido: a
  /// clínica já recebeu a mensagem, ela faz parte do registro do atendimento, e
  /// um prontuário que se reescreve sozinho vale menos. O que muda é a tela, que
  /// mostra "Mensagem apagada" em vez do texto — a atendente vê que a pessoa se
  /// retratou, que é a informação que ela precisa para conduzir a conversa.
  deletedAt DateTime?

  /// Quando a clínica **editou** o texto desta mensagem depois de enviá-la.
  ///
  /// O conteúdo anterior **não** é guardado, e isto é escolha: o WhatsApp
  /// substitui o texto para quem recebeu, e manter aqui a versão que o paciente
  /// não vê mais faria a tela da atendente discordar do celular dele — que é o
  /// oposto do que esta tela existe para fazer. Quem precisa de histórico de
  /// alteração precisa de uma tabela de versões, não de uma coluna.
  ///
  /// O que a coluna dá é o aviso: a bolha mostra "editada", para ninguém ler um
  /// texto e supor que foi aquilo que saiu na hora.
  ///
  /// Só o canal QR escreve aqui. No oficial a Meta não oferece edição.
  editedAt DateTime?

  createdAt DateTime @default(now())

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recados      TeamMessage[]

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

/// Quem **colabora** numa conversa sem ser o responsável por ela.
///
/// É o item 6 do Vol. III, e a forma dele saiu de uma pergunta do Andre: o
/// `transferir` que já existe não substitui isto, porque transferir **troca** o
/// responsável e colaborar **soma** — ele pediu que a conversa aparecesse para
/// o responsável e também para quem foi chamado.
///
/// O nome é dele, e bate com o vocabulário do respond.io: o filtro deles chama
/// "Colaborações" (medido em `docs/re-respond-io/screens/S-003-inbox.md`). São
/// N pessoas por conversa, não uma.
///
/// ## Escrita pela menção, nunca por um botão de assinar
///
/// Não há ação "colaborar" na interface. A linha nasce quando alguém escreve
/// uma nota interna marcando `@colega`, e é isso que o respond.io faz: o modelo
/// deles não tem entidade de follow, tem comentário com menção e o filtro
/// acima. A visibilidade é consequência de colaborar.
///
/// A alternativa — botão próprio **e** menção — daria dois caminhos para a
/// mesma linha, e dois caminhos divergem: a lista mostraria alguém colaborando
/// sem nota que explique por quê.
///
/// ## O que colaborar dá, e o que não dá
///
/// Dá **leitura**: a conversa entra na lista de quem colabora mesmo fora do
/// departamento dele, e ele é avisado. Não dá resposta — para responder, assume,
/// e assumir grava `assignedTo`, que é o gesto que já existe, que o produto
/// registra e que cala o agente.
///
/// **É um buraco na parede do departamento, de propósito** — a regra geral é
/// que o recorte fecha em vez de abrir (PRODUCT.md §11). O buraco é de *uma*
/// conversa, nomeado, e com quem o abriu gravado em `addedByUserId`. A parede
/// da **unidade** continua fechada: `quemPassaAColaborar` recusa quem não é
/// membro, e é a diferença entre pedir ajuda a uma colega e expor a conversa de
/// um paciente para outra clínica.
model ConversationCollaborator {
  conversationId String
  userId         String
  /// Quem chamou. É o que torna o buraco auditável — e `SetNull` porque a linha
  /// de quem colabora não pode morrer quando quem o chamou sai da clínica.
  addedByUserId  String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversasQueColabora", fields: [userId], references: [id], onDelete: Cascade)
  addedBy      User?        @relation("ColaboradoresQueChamou", fields: [addedByUserId], references: [id], onDelete: SetNull)

  /// Marcar a mesma pessoa duas vezes é ênfase, não dois colaboradores.
  @@id([conversationId, userId])
  /// O caminho quente: "as conversas em que eu colaboro", o filtro da coluna.
  @@index([userId])
  @@map("conversation_collaborators")
}

/// O convite de usuário: o acesso nasce quando a pessoa aceita, não quando o
/// administrador clica.
///
/// ## Por que esta tabela existe
///
/// Até aqui "convidar" era o administrador **digitar a senha** de outra pessoa
/// e avisá-la por e-mail — o próprio template pedia que ela ligasse perguntando
/// qual era. Além de ruim, é incompatível com a LGPD: a senha é dado de
/// autenticação do titular, e quem a escolhe tem de ser ele.
///
/// Então a ordem inverte. `User` e `AuthAccount` **não existem** enquanto o
/// convite está pendente: o que existe é esta linha, guardando o que a pessoa
/// vai ser (papel, departamentos) e nada do que ela é. No aceite, ela define a
/// senha e as três linhas nascem juntas.
///
/// ## O token não está aqui
///
/// `tokenHash` é o SHA-256 dele. O token **é** a credencial — quem o tem define
/// a senha de um usuário dentro da clínica —, então guardá-lo em claro faria de
/// qualquer leitura do banco (um dump, um `SELECT` de suporte) uma entrega de
/// acesso. Ver `lib/convite/token.ts`.
///
/// ## O estado é derivado, e por isso não é coluna
///
/// `pendente | aceito | revogado | expirado` sai de `acceptedAt`, `revokedAt` e
/// `expiresAt` em `lib/convite/estado.ts`. Uma coluna `estado` viraria mentira
/// sozinha: gravada como "pendente", ela fica expirada quando o relógio passa,
/// e **nada escreve na linha nesse instante**.
model Invite {
  id          String @id @default(cuid())
  workspaceId String

  /// Sempre minúsculo e sem espaço (`normalizarEmail`): o endereço é digitado
  /// por duas pessoas diferentes — quem convida e quem aceita — e
  /// "Ana@Clinica.com " não pode virar um segundo convite.
  email String
  role  String

  /// O que a pessoa vai poder, guardado até o aceite.
  canTransfer     Boolean @default(false)
  recebeConversas Boolean @default(true)

  /// Os departamentos, como lista de ids.
  ///
  /// Json e não tabela de junção porque o convite é efêmero e a lista só é
  /// lida uma vez, no aceite. O preço é que um departamento apagado entre o
  /// convite e o aceite deixa um id morto aqui — e o aceite **filtra pelos
  /// departamentos que existem naquela unidade**, que é a mesma guarda
  /// anti-cross-tenant que a criação direta já fazia.
  departmentIds Json?

  /// SHA-256 do token. Único porque é por ele que o aceite acha a linha.
  tokenHash String   @unique
  expiresAt DateTime

  invitedByUserId String?
  /// Os três instantes de que o estado é derivado.
  acceptedAt      DateTime?
  acceptedUserId  String?
  revokedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// `SetNull`: o convite que alguém mandou não desaparece quando essa pessoa
  /// sai da clínica — "quem convidou" é registro, e perdê-lo apagaria a
  /// auditoria de como cada um entrou.
  invitedBy User?     @relation("ConvitesQueEnviou", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  accepted  User?     @relation("ConviteQueAceitou", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  /// A lista de convites da unidade, e a procura por e-mail antes de convidar
  /// de novo.
  @@index([workspaceId, email])
  @@index([workspaceId, createdAt])
  @@map("invites")
}

// ============================================
// 5. INTEGRATIONS (WhatsApp, Instagram, etc)
// ============================================

/// Credentials of the OAuth application itself — one registration per provider,
/// shared by every clinic.
///
/// A clinic should click "Conectar", pick its account and be done; it should not
/// have to create a Google Cloud project. These used to be environment
/// variables, which made the connection a deploy task and put the product
/// owner's shell access between a clinic and its own calendar. A workspace may
/// still register its own application in `Integration.credentials` — a clinic on
/// Google Workspace may prefer an Internal app — and that takes precedence.
model PlatformCredential {
  id          String   @id @default(cuid())
  /// "google_calendar", "google_ads", "meta_ads", "clinicorp"…
  provider    String   @unique
  /// clientId / clientSecret, and whatever else a provider needs. Plaintext, as
  /// Integration.credentials already is; encrypting it needs a key that would
  /// live in the environment we just emptied.
  credentials Json
  metadata    Json?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_credentials")
}

model Integration {
  id          String @id @default(cuid())
  workspaceId String

  provider String // "whatsapp", "instagram", "meta_ads", "google_ads"
  status   String @default("pending") // "pending", "connected", "error"

  // Credentials (encrypted)
  credentials Json? // API keys, tokens

  // WhatsApp specific
  phoneNumber String?
  qrCode      String? @db.Text

  metadata   Json?
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([provider])
  @@map("integrations")
}

// ============================================
// 6. BILLING & SUBSCRIPTIONS
// ============================================

model Subscription {
  id        String @id @default(cuid())
  /// Uma assinatura por conta, cobrindo todas as unidades dela.
  accountId String @unique

  /// A assinatura recorrente correspondente no Asaas.
  ///
  /// `cycle: MONTHLY`, valor = plano + unidades adicionais. Única por ser 1:1.
  /// Nula enquanto a conta não contratou — ou quando é vitalícia.
  asaasSubscriptionId String? @unique

  plan   String // "flow", "pro", "advanced"
  status String @default("active") // "active", "past_due", "canceled", "trialing"

  /// "monthly" | "annual" — de quanto em quanto tempo esta conta é cobrada.
  ///
  /// O anual desconta 10% em todos os planos (decisão do Andre em 2026-11-07) e
  /// cobra os doze meses numa fatura, com `cycle: YEARLY` no Asaas.
  ///
  /// **Não é o ciclo da franquia.** O crédito renova de 30 em 30 dias nos dois,
  /// senão quem paga doze meses adiantado receberia 120.000 créditos para
  /// gastar no primeiro mês. É por isso que existem duas datas — ver `renewsAt`.
  billingCycle String @default("monthly")

  /// Quando a **cobrança** se repete. `currentPeriodEnd` é a franquia.
  ///
  /// No mensal as duas andam juntas e o cron de renovação as move no mesmo
  /// passo. No anual elas se separam: a franquia vira doze vezes e esta, uma.
  ///
  /// Nulo na assinatura criada antes desta coluna, e aí quem responde "quando
  /// é a próxima cobrança" continua sendo `currentPeriodEnd` — que é a resposta
  /// certa para toda assinatura mensal, que é o que existia até aqui.
  renewsAt DateTime?

  /// Quando o cliente pediu o cancelamento. Nulo = assinatura de pé.
  ///
  /// Gravado porque **desfazer** precisa de duas coisas que o `status` não
  /// guarda: saber que ainda estamos dentro do período pago, e achar os
  /// adicionais que caíram **neste** cancelamento — eles levam este mesmo
  /// carimbo em `canceledAt`, e é por ele que a restauração os encontra sem
  /// ressuscitar o que o cliente havia cancelado à mão antes.
  canceledAt DateTime?

  /// Os tetos **pagos**, que podem estar acima do plano vigente.
  ///
  /// Desde 2026-10-19 esta cópia tem função, e não é mais só histórico: ao
  /// descer de plano, `plan` muda na hora e estes números **ficam** até a
  /// renovação. É assim que "todos os recursos do plano superior continuam
  /// valendo até a renovação" acontece sem precisar de plano agendado — a
  /// leitura usa o maior entre a cópia e a tabela do plano. Na virada, o cron
  /// de renovação os traz para o plano vigente e desliga o que não couber.
  maxAgents   Int @default(1)
  maxMessages Int @default(100)

  /// Quantas respostas o agente pode **falar** no mês, pelo plano.
  ///
  /// Teto, e não peso no crédito: a fala custa cerca de dez vezes o texto, e
  /// cobrar 2 créditos por resposta falada tornava a carteira imprevisível para
  /// quem olha. É este teto que fecha o pior caso dentro dos 10% da mensalidade
  /// destinados a custo de IA. Zero significa sem fala — é o que vale para a
  /// assinatura criada antes desta coluna existir, até o plano ser reaplicado.
  maxSpokenReplies   Int @default(0)
  // How many WhatsApp numbers the plan allows to be connected at once.
  maxWhatsAppNumbers Int @default(1)

  // Credits
  credits     Int @default(0) // Créditos de IA disponíveis
  creditsUsed Int @default(0) // Créditos utilizados no mês

  // Billing
  stripeId      String?
  paymentMethod Json? // { type, last4, brand }
  trialStartsAt DateTime? // O cadastro do proprietário, não o fim do onboarding
  trialEndsAt   DateTime? // 23:59 do sétimo dia, fuso America/Sao_Paulo
  /// Quando o workspace entrou em somente-leitura. Inicia a contagem de retenção.
  readOnlySince DateTime?

  /// Desde quando há cobrança vencida, e até quando a clínica tem para pagar.
  ///
  /// A carência é 3 dias no cartão e 2 no Pix, contada do vencimento. Fica
  /// gravada porque quem corta é um cron de madrugada, que não tem o evento do
  /// gateway em mãos — recalcular a partir da fatura obrigaria a varrer
  /// cobranças para decidir sobre assinaturas.
  pastDueSince       DateTime?
  graceEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

/// Avulso credits. Kept apart from the plan's allowance because the two expire
/// differently: plan credits are discarded on renewal, these last 90 days from
/// purchase or until spent. Consumption takes plan credits first, since those
/// die at renewal anyway.
model CreditPurchase {
  id          String   @id @default(cuid())
  workspaceId String
  amount      Int
  used        Int      @default(0)
  priceCents  Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, expiresAt])
  @@map("credit_purchases")
}

/// Who accepted which version of the terms, and when. Recorded on the last step
/// of onboarding.
model TermsAcceptance {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  version     String
  acceptedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, version])
  @@map("terms_acceptances")
}

/// One row per notification actually sent, so a job that runs twice — or catches
/// up after being down — does not send the same warning again. `scope` carries
/// whatever makes the notice repeatable: a billing period for a recurring
/// warning, empty for a once-ever one.
/// Um aviso que espera ser visto.
///
/// O lembrete de atividade só chegava a quem estivesse com a aba aberta no
/// minuto exato — o próprio processador admitia isso num comentário. Aqui o
/// aviso fica guardado até alguém ler, o que é a diferença entre "notifiquei" e
/// "a pessoa soube".
///
/// `userId` nulo é aviso do workspace inteiro — o boletim da manhã, por
/// exemplo, quando ninguém em particular é o dono dele.
model Notification {
  id          String  @id @default(cuid())
  workspaceId String
  userId      String?

  /// "follow_up", "reminder", "briefing" — agrupa e escolhe o ícone.
  kind  String
  title String
  body  String? @db.Text
  /// Para onde o clique leva, relativo à aplicação.
  link  String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationLog {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String
  scope       String   @default("")
  sentTo      String
  sentAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, kind, scope])
  @@index([workspaceId, sentAt])
  @@map("notification_logs")
}

model UsageLog {
  id          String  @id @default(cuid())
  workspaceId String
  agentId     String?

  provider String // "openai"
  model    String // ver OPENAI_MODELS em src/lib/llm/models.ts

  promptTokens     Int
  completionTokens Int
  totalTokens      Int

  costUsd Decimal @db.Decimal(10, 6)

  metadata  Json? // { conversationId, userId, contactId, etc }
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([agentId])
  @@map("usage_logs")
}

// ============================================
// 7. ORGANIZATION (Departments, Tags, Products)
// ============================================

// ============================================
// AGENDA: QUEM ATENDE, QUANDO, E QUANDO A CLÍNICA FECHA
// ============================================

/// Quem executa o procedimento.
///
/// **Não é um usuário do sistema.** `Activity.userId` já existe e significa
/// "Responsável" — quem da equipe cuida da tarefa, escolhido entre os membros
/// que fazem login. O cirurgião normalmente não faz login: quem marca é a
/// recepção. São duas perguntas diferentes sobre o mesmo compromisso, e por isso
/// duas colunas.
///
/// `userId` liga os dois quando a mesma pessoa faz as duas coisas.
model Professional {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  /// "Implantodontia", "Ortodontia" — texto livre, porque cada clínica nomeia
  /// as suas do seu jeito.
  specialty   String?
  /// Para distinguir as agendas na visão por especialista.
  color       String  @default("#06B6D4")
  isActive    Boolean @default(true)
  /// O membro do workspace que é esta pessoa, quando ela também usa o sistema.
  userId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  windows    AvailabilityWindow[]
  activities Activity[]

  @@index([workspaceId])
  @@map("professionals")
}

/// Uma faixa de horário recorrente em que o especialista atende.
///
/// **Uma lista só, não duas.** A tentação era separar "horário de trabalho" de
/// "janela liberada para o agente" — e aí os dois divergem: alguém muda o
/// expediente, esquece a janela, e o agente marca num horário em que a doutora
/// não está. Aqui a permissão é um campo da própria faixa.
model AvailabilityWindow {
  id             String @id @default(cuid())
  professionalId String

  /// 0 = domingo, 6 = sábado, como `Date.getDay()`.
  weekday   Int
  /// "14:00". Mesma forma de `Activity.startTime`, que a agenda já desenha.
  startTime String
  endTime   String

  /// Se o agente de IA pode marcar sozinho aqui.
  ///
  /// Desligado por padrão: liberar a agenda para uma IA é decisão explícita da
  /// clínica, nunca o que acontece por omissão.
  agentCanBook Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  professional Professional                @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  services     AvailabilityWindowService[]

  @@index([professionalId])
  @@map("availability_windows")
}

/// Quais procedimentos cabem nesta janela.
///
/// Sem esta lista, o agente encaixaria um implante de duas horas numa janela de
/// duas horas e tomaria a tarde inteira da doutora a partir de uma conversa de
/// WhatsApp. Com ela, a clínica diz "aqui o agente marca avaliação, e só".
///
/// Vazia significa **nenhum** procedimento liberado, não todos: o padrão de uma
/// permissão é não ter permissão.
model AvailabilityWindowService {
  windowId         String
  productServiceId String

  window  AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  product ProductService     @relation(fields: [productServiceId], references: [id], onDelete: Cascade)

  @@id([windowId, productServiceId])
  @@index([productServiceId])
  @@map("availability_window_services")
}

/// O que sobrepõe as janelas de **todos** os especialistas.
///
/// Feriado, recesso, dedetização. Vale para a clínica inteira e ganha das
/// janelas — é o "sobrepõe a agenda".
///
/// **Duas formas na mesma tabela**, e a diferença é `holidayKey`:
///
///   - Com `holidayKey`: é a decisão da clínica sobre um feriado nacional. A
///     data **não** mora aqui, porque Carnaval, Sexta-feira Santa e Corpus
///     Christi se movem com a Páscoa — gravá-los como "anual em data fixa"
///     estaria errado já no ano seguinte. A lista nacional é calculada em
///     `src/lib/holidays.ts`; esta linha diz só se aquele feriado bloqueia aqui.
///     Sem linha nenhuma, bloqueia — que é o certo para a maioria.
///   - Sem `holidayKey`: é entrada própria da clínica, e aí as datas são estas.
model ScheduleException {
  id          String @id @default(cuid())
  workspaceId String

  /// A chave do feriado nacional que esta linha decide. Null = entrada própria.
  holidayKey String?
  name       String

  /// Nulas quando `holidayKey` manda: o feriado sabe a própria data.
  startsOn DateTime? @db.Date
  endsOn   DateTime? @db.Date

  /// Dia inteiro, ou só um pedaço dele.
  allDay    Boolean @default(true)
  startTime String?
  endTime   String?

  /// Bloqueia a agenda, ou é só informativo ("atendemos neste feriado").
  blocks Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Um feriado nacional tem no máximo uma decisão por clínica.
  @@unique([workspaceId, holidayKey])
  @@index([workspaceId])
  @@map("schedule_exceptions")
}

model Department {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?

  workspace  Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members    WorkspaceUserDepartment[]
  lines      AgentIntegration[]
  /// Texto já normalizado para busca — minúsculo e sem acento.
  ///
  /// Coluna GERADA pelo Postgres (ver a migração
  /// `20261010100000_accent_insensitive_search`): existe aqui para que o Prisma
  /// possa filtrar por ela, e **nunca deve ser escrita** — o banco recusa. É o
  /// que faz "André" e "andre" localizarem a mesma pessoa sem SQL cru em cada
  /// rota de busca.
  searchText String?

  @@index([workspaceId])
  @@map("departments")
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#6B7280")

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contacts      ContactTag[]
  conversations ConversationTag[]
  /// Texto já normalizado para busca — minúsculo e sem acento.
  ///
  /// Coluna GERADA pelo Postgres (ver a migração
  /// `20261010100000_accent_insensitive_search`): existe aqui para que o Prisma
  /// possa filtrar por ela, e **nunca deve ser escrita** — o banco recusa. É o
  /// que faz "André" e "andre" localizarem a mesma pessoa sem SQL cru em cada
  /// rota de busca.
  searchText    String?

  @@index([workspaceId])
  @@map("tags")
}

model ConversationTag {
  conversationId String
  tagId          String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([conversationId, tagId])
  @@map("conversation_tags")
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model ProductService {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String? @db.Text
  sku         String? // Código do produto
  category    String  @default("product") // "product" | "service" | "procedure"
  price       Float?

  /// Quanto tempo este item ocupa na agenda.
  ///
  /// Vale para `service` **e** `procedure` — ver `SCHEDULABLE_CATEGORIES` em
  /// `src/lib/product-categories.ts`. Era só de `procedure`, e as duas rotas
  /// zeravam a duração de serviço mesmo que alguém a mandasse; só que limpeza
  /// e clareamento ocupam cadeira igual a um implante, e a diferença entre
  /// serviço e procedimento é de catálogo, não de agenda.
  ///
  /// Avaliação são 30 minutos, implante são 120. É daqui que a agenda tira o
  /// tamanho do compromisso, e é o que impede o agente de encaixar uma cirurgia
  /// no buraco de uma consulta. Nulo em `product`, que não ocupa cadeira.
  ///
  /// Mora no Item, e não numa tabela à parte, porque é aqui que a clínica já
  /// pensa no procedimento — com nome e preço. Mudar de 30 para 40 minutos
  /// passa a ser um lugar só.
  durationMinutes Int?
  currency        String  @default("BRL")
  group           String? // Grupo/categoria do produto

  /// Texto já normalizado para busca — minúsculo e sem acento.
  ///
  /// Coluna GERADA pelo Postgres (ver a migração
  /// `20261010100000_accent_insensitive_search`): existe aqui para que o Prisma
  /// possa filtrar por ela, e **nunca deve ser escrita** — o banco recusa. É o
  /// que faz "André" e "andre" localizarem a mesma pessoa sem SQL cru em cada
  /// rota de busca.
  searchText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  windows    AvailabilityWindowService[]
  activities Activity[]

  @@index([workspaceId])
  @@index([name])
  @@index([sku])
  @@map("products_services")
}

// ============================================
// 8. KNOWLEDGE BASE (RAG)
// ============================================

model KnowledgeDocument {
  id      String @id @default(cuid())
  agentId String

  title   String
  content String  @db.Text
  type    String // "faq", "doc", "website", "video"
  url     String?

  // Vector embeddings (pgvector)
  embedding Unsupported("vector(1536)")?

  /// A perna lexical da busca híbrida: `to_tsvector('portuguese', unaccent(content))`.
  /// Coluna GERADA — o Postgres a mantém, e nada no código a escreve. Declarada
  /// aqui só para o Prisma não a propor como coluna a remover no próximo diff.
  searchVector Unsupported("tsvector")?

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("knowledge_documents")
}

// ============================================
// CUSTOM FIELD DEFINITIONS (Workspace-scoped)
// ============================================

model CustomFieldDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  name        String // Display name
  key         String // Programmatic key (snake_case)
  type        String // "text", "number", "date", "select", "checkbox"
  options     Json? // For select type: ["Option A", "Option B"]
  required    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("custom_field_definitions")
}

/// O cofre da aplicação, substituindo o cofre que era do banco.
///
/// O Neon não oferece a extensão de cofre da plataforma anterior nem
/// `pgsodium` — conferido em `pg_available_extensions` do projeto `odontobox`
/// em 2026-10-21 —, então a
/// cifra deixa de ser do banco e passa a ser da aplicação: `value` guarda o
/// envelope AES-256-GCM de `lib/secrets/envelope.ts`, e a chave vive em
/// Cloudflare Secrets, fora deste banco.
///
/// **O que NÃO entra aqui.** Os cinco segredos de plataforma (apps da Meta, do
/// Instagram e do Asaas) são globais e de valor fixo: são configuração de
/// implantação e ficam em Cloudflare Secrets, lidos de `env`. Esta tabela é para
/// o que a aplicação precisa **gravar** em tempo de execução — e para provedor
/// novo que ainda não tenha secret publicado.
model AppSecret {
  id          String   @id @default(cuid())
  /// O mesmo nome que o Vault usava: `platform:<provedor>:<campo>`.
  name        String   @unique
  /// Envelope `{ v, iv, ct }`. Nunca valor em claro.
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("app_secrets")
}

// ============================================
// BETTER AUTH — os três modelos da biblioteca
// ============================================
//
// Substituem as tabelas de usuário, sessão e identidade do provedor anterior,
// que viviam num schema próprio fora do alcance do Prisma. Agora são tabelas
// comuns no mesmo banco — o que permite ao Worker resolver a sessão sem ida à
// rede, e juntar usuário com `WorkspaceUser` numa consulta só.
//
// Os três levam prefixo `Auth` porque `Account` já existe neste schema e é a
// conta que assina, com `name` obrigatório e dados de cobrança. O CLI do Better
// Auth avisou que, sem o rename, "inserts into account will fail" — e afrouxar
// `name` para resolver misturaria credencial de login com conta de cobrança na
// mesma tabela.

/// Uma sessão ativa. O cookie carrega `token`; o resto fica aqui.
model AuthSession {
  id        String   @id @default(cuid())
  /// O valor que o cookie assinado carrega. Único: é a chave de busca.
  token     String   @unique
  expiresAt DateTime
  /// Guardados para a pessoa poder reconhecer a sessão numa lista e encerrá-la.
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Um método de autenticação ligado a um usuário.
///
/// Para e-mail e senha, `providerId` é "credential" e `password` guarda o hash —
/// é a única coluna deste schema que guarda hash de senha, e é por isso que
/// `User.hashedPassword` fica obsoleta (ver a migração).
///
/// Para OAuth, guarda os tokens do provedor. **Token de integração de workspace
/// não vem para cá**: aquele é cifrado em `Integration.config` com a chave em
/// Cloudflare Secrets, e é outro assunto — ver `src/lib/secrets/envelope.ts`.
model AuthAccount {
  id                    String    @id @default(cuid())
  /// O id da pessoa junto ao provedor. Para credencial, é o próprio `userId`.
  accountId             String
  /// "credential" para e-mail e senha; "google", "apple"… para OAuth.
  providerId            String
  userId                String
  /// Hash da senha. Nulo em conta de OAuth, que não tem senha.
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("auth_accounts")
}

/// Token de uso único: confirmação de e-mail, redefinição de senha, OTP.
///
/// `value` é o token e `identifier` é a que se refere (normalmente o e-mail).
/// A linha é consumida no uso e expira sozinha — nada aqui é de longo prazo.
model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}

/// O contador do limite de requisições do Better Auth.
///
/// **Por que em banco e não em memória.** O padrão da biblioteca é um
/// `new Map()` no módulo. Em Cloudflare Workers cada isolate carrega o módulo
/// de novo e tem o próprio mapa — e os isolates são muitos, espalhados e
/// efêmeros. O limite efetivo viraria "N por janela por isolate", que para quem
/// adivinha senha é o mesmo que não haver limite. Ver
/// `src/lib/auth/better-auth.ts`.
///
/// Linha curta e muito escrita: um `UPDATE` por requisição autenticável. Se o
/// custo disso aparecer na conta do Neon, o próximo destino é Durable Object ou
/// KV — não voltar para memória.
model AuthRateLimit {
  id          String @id @default(cuid())
  /// Identifica quem está sendo limitado e em qual rota. Único: é a chave de busca.
  key         String @unique
  count       Int
  /// Instante da última requisição, em milissegundos desde a época.
  ///
  /// `BigInt` e não `Int`: milissegundos desde 1970 passam de 2^31 desde 1971,
  /// e um `Int` de 32 bits estouraria silenciosamente.
  lastRequest BigInt

  @@map("auth_rate_limits")
}

// ============================================
// FILAS E TEMPO REAL NA CLOUDFLARE
// ============================================

/// O evento a publicar, gravado na mesma transação do dado que o gerou.
///
/// **Por que isto existe.** O tempo real anterior lia o WAL do Postgres: gravar
/// a linha *era* publicar o evento. O Neon não publica WAL para a Cloudflare, e
/// nenhuma configuração muda isso — então escrita no banco **não chega sozinha**
/// ao Durable Object. Quem assume o contrário constrói um sistema que funciona
/// em teste e perde eventos em produção.
///
/// **Por que na mesma transação, e não um `enqueue` depois do commit.** Publicar
/// direto na fila dentro da rota parece mais simples e é errado: se o commit
/// falhar depois do enqueue, o evento existe e o dado não — e o navegador recebe
/// "tem mensagem nova" para uma mensagem que não foi gravada. Aqui as duas
/// coisas são atômicas: ou existem as duas, ou nenhuma.
///
/// O publicador roda nos dois caminhos: chamada direta depois do commit, para
/// latência, e uma varredura por Cron Trigger, para recuperar o que a chamada
/// direta perdeu. O segundo é o que torna o primeiro dispensável em caso de
/// falha.
model OutboxEvent {
  id          String    @id @default(cuid())
  workspaceId String
  /// `mensagem.nova`, `conversa.alterada`, `agente.status`…
  tipo        String
  /// **Identificadores, nunca conteúdo.**
  ///
  /// O evento diz "a conversa X tem mensagem nova"; o navegador busca o
  /// conteúdo pela rota autenticada. Assim conteúdo clínico não transita por
  /// fila nem aparece em log de fila — e o payload não precisa ser cifrado.
  payload     Json
  createdAt   DateTime  @default(now())
  /// Nulo enquanto não publicado. É o índice parcial que a varredura usa.
  publishedAt DateTime?
  /// Quantas vezes a publicação foi tentada. Serve para parar de insistir.
  tentativas  Int       @default(0)
  /// O erro da última tentativa, para diagnóstico. Sem dado sensível.
  ultimoErro  String?

  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@map("outbox_events")
}

/// A deduplicação que o `jobId` do BullMQ dava de graça.
///
/// **A diferença que mais importa entre BullMQ e Cloudflare Queues.** O BullMQ
/// aceita um id de job escolhido por nós e recusa um segundo job com o mesmo id
/// — é assim que hoje um webhook reenviado pelo provedor não vira duas mensagens
/// (ver `lib/queue/enqueue-whatsapp.ts`). **Cloudflare Queues não tem isso**, e
/// entrega *at-least-once* por desenho: repetição é o normal, não a exceção.
///
/// Então a dedup desce para o banco, onde a unicidade é garantida pelo índice e
/// não pela boa vontade do broker.
///
/// `expiraEm` existe para a tabela não crescer para sempre: a janela só precisa
/// cobrir o tempo em que um provedor ainda pode reenviar o mesmo evento. A
/// varredura de retenção apaga o que passou.
model ProcessedMessage {
  /// A chave de idempotência: `<fila>:<id externo>`. Única — é ela que deduplica.
  chave     String   @id
  fila      String
  createdAt DateTime @default(now())
  expiraEm  DateTime

  @@index([expiraEm])
  @@map("processed_messages")
}

// ───────────────────────── Marketing / Broadcast (B2) ─────────────────────────

/// Um domínio pelo qual esta unidade manda campanha de e-mail.
///
/// ## Por que o remetente é do cliente, e não nosso
///
/// Campanha sai do domínio da própria clínica (`contato@clinica.com.br`), nunca
/// de um subdomínio nosso. Dois motivos, e o segundo é o que decide:
///
/// 1. **Quem recebe reconhece quem mandou.** E-mail de `mkt.venn360.com` com o
///    nome da clínica no remetente é exatamente a forma de um phishing.
/// 2. **Reputação não se compartilha.** Uma clínica que importa lista comprada
///    queima a reputação do domínio por onde ela envia. Se esse domínio fosse
///    nosso, ela derrubaria a entrega de todas as outras — e a do transacional,
///    que carrega recuperação de senha e aviso de cobrança. Com domínio por
///    cliente, o estrago fica onde nasceu.
///
/// ## O estado é do SES, não nosso
///
/// `dkimTokens` são os três CNAME que o cliente publica na zona dele; `status`
/// só vira `verified` quando o SES confirma o DKIM (o cron `ses-verificar-remetente`
/// pergunta). **Campanha não sai de remetente que não esteja `verified`** — é o
/// mesmo portão que o WhatsApp tem com template aprovado, e pela mesma razão:
/// disparar sem autenticação é queimar o domínio do cliente de uma vez.
model EmailSender {
  id          String @id @default(cuid())
  workspaceId String

  /// O domínio verificado no SES. Pode ser o apex (`clinica.com.br`) ou um
  /// subdomínio (`mkt.clinica.com.br`) — o SES trata cada um como identidade
  /// própria, e subdomínio separa a reputação de marketing da do e-mail que a
  /// equipe usa no dia a dia.
  domain String

  /// A parte antes do @. Junto com `domain` forma o `From`.
  fromLocal String @default("contato")

  /// O nome que aparece na caixa de entrada de quem recebe.
  fromName String

  /// Para onde vai a resposta. Obrigatório na prática: campanha gera resposta, e
  /// não existe canal de e-mail no inbox — sem isto a resposta do contato morre.
  replyTo String

  /// Os tokens do Easy DKIM. Três, e cada um vira um CNAME
  /// `<token>._domainkey.<domain>` → `<token>.dkim.amazonses.com`.
  dkimTokens String[] @default([])

  status String @default("pending") // pending|verified|failed

  /// O estado cru do DKIM no SES (`PENDING`, `SUCCESS`, `FAILED`,
  /// `TEMPORARY_FAILURE`). Guardado para a tela dizer *por que* não verificou em
  /// vez de só "falhou" — `TEMPORARY_FAILURE` é esperar, `FAILED` é o CNAME estar
  /// errado.
  dkimStatus String?

  /// O configuration set do SES que publica os eventos deste remetente. É por
  /// ele que entrega, abertura, clique e reclamação voltam para nós.
  configurationSetName String?

  verifiedAt    DateTime?
  lastCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  /// Um remetente por domínio em cada unidade. O SES guarda uma identidade por
  /// domínio na conta inteira, então duas linhas para o mesmo domínio na mesma
  /// unidade seriam duas vistas do mesmo estado, divergindo na primeira
  /// verificação.
  @@unique([workspaceId, domain])
  @@index([status])
  @@map("email_senders")
}

/// Uma lista de contatos para campanha. Entidade de primeira classe porque a
/// campanha se associa a listas, não a um filtro solto: a lista é nomeada,
/// reutilizável e — no disparo — congelada em destinatários.
///
/// `kind = "static"` guarda os membros em `ContactListMember`. `kind = "dynamic"`
/// guarda um `filter` (os mesmos filtros de `consultarPacientes`) a reavaliar;
/// hoje o disparo usa os membros congelados (ver docs/paridade-respond-io/DUVIDAS-B2.md D3).
model ContactList {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  kind        String @default("static") // "static" | "dynamic"

  /// Por qual canal esta lista serve: `whatsapp` | `email`.
  ///
  /// Não é enfeite de tela — muda **quem entra na lista**. Lista de WhatsApp só
  /// aceita contato com telefone; lista de e-mail só aceita contato com e-mail.
  /// Uma lista só, servindo aos dois, mandaria a metade sem endereço para o
  /// fan-out só para ela ser descartada lá, e a contagem que a tela mostra
  /// mentiria sobre o alcance da campanha.
  channel   String   @default("whatsapp")
  /// Filtros de origem quando a lista nasce de uma busca de pacientes. Informativo
  /// em lista estática; o critério a reavaliar em lista dinâmica.
  filter    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members    ContactListMember[]
  broadcasts BroadcastList[]

  @@index([workspaceId])
  @@map("contact_lists")
}

model ContactListMember {
  listId    String
  contactId String
  addedAt   DateTime @default(now())

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
  @@map("contact_list_members")
}

/// Espelho local de um template de mensagem aprovado na Meta (HSM).
///
/// O template é criado e aprovado no painel da Meta; aqui guardamos uma cópia
/// para a campanha escolher sem uma chamada à Graph a cada tela. `components`
/// traz header/body/footer/buttons com os marcadores `{{1}}`, e é o que a tela
/// usa para pedir o preenchimento das variáveis.
model WhatsAppTemplate {
  id            String   @id @default(cuid())
  workspaceId   String
  /// A linha (WABA) de onde o template veio. Templates são por conta de negócio.
  integrationId String
  metaName      String
  language      String
  category      String // MARKETING | UTILITY | AUTHENTICATION
  status        String // APPROVED | PENDING | REJECTED | PAUSED | DISABLED
  components    Json
  syncedAt      DateTime @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration AgentIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  broadcasts  Broadcast[]

  @@unique([integrationId, metaName, language])
  @@index([workspaceId])
  @@map("whatsapp_templates")
}

/// Uma campanha de disparo em massa, por WhatsApp oficial **ou** por e-mail.
///
/// ## Um modelo, dois canais
///
/// `channel` discrimina, e é ele que diz quais colunas valem:
///
/// | `channel`   | exige                                  | entrega por |
/// |-------------|----------------------------------------|-------------|
/// | `whatsapp`  | `integrationId` + `templateId`         | Graph API da Meta, template HSM aprovado |
/// | `email`     | `senderId` + `emailTemplateId` + `subject` | Amazon SES, domínio do cliente |
///
/// Os dois canais foram para o mesmo modelo porque o que é caro já é comum: o
/// fan-out em duas fases, o ritmo escalonado, a idempotência por destinatário e
/// o fechamento da campanha não têm nada de canal. Separar em dois modelos
/// duplicaria `src/trabalhos/servicos/broadcast.ts` inteiro, e a segunda cópia
/// divergiria na primeira correção feita só numa delas.
///
/// `integrationId` e `templateId` ficaram **nulos** para caber o e-mail. A
/// obrigatoriedade não desapareceu — mudou de lugar: quem a aplica é a
/// validação por canal na rota, porque o banco não sabe expressar "obrigatório
/// quando `channel = 'whatsapp'`".
///
/// Só a linha `whatsapp_business` dispara (o QR não alcança o broadcast, por
/// decisão). `status` percorre draft→scheduled→running→done|failed; `canceled`
/// é saída manual. Os contadores são denormalizados para a lista não ter de
/// contar destinatários a cada pintura.
model Broadcast {
  id          String   @id @default(cuid())
  workspaceId String
  name        String // interno, visível só à equipe
  labels      String[] @default([])

  /// `whatsapp` | `email`. Default preserva as campanhas que já existem — elas
  /// nasceram todas de WhatsApp, quando era o único canal.
  channel String @default("whatsapp")

  integrationId String? // linha whatsapp_business — obrigatória quando channel = whatsapp
  templateId    String? // WhatsAppTemplate aprovado — idem
  /// Mapeamento das variáveis do template ({{1}} → valor/campo). Forma livre.
  variables     Json?

  /// Por onde o e-mail sai. Obrigatório quando `channel = 'email'`, e tem de
  /// estar `verified` para a campanha deixar o rascunho.
  senderId        String?
  emailTemplateId String?

  /// O assunto. Fica na campanha, e não no template, porque é o que mais muda
  /// entre dois disparos do mesmo conteúdo — e é o que se testaria num A/B.
  subject   String?
  /// A linha de prévia que aparece ao lado do assunto na caixa de entrada.
  preheader String?

  status         String    @default("draft") // draft|scheduled|running|done|failed|canceled
  scheduledAt    DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  /// Teto de envios por minuto no fan-out. Conservador por padrão; o tier real
  /// da WABA define o seguro (ver DUVIDAS-B2.md D2).
  throttlePerMin Int       @default(30)
  totalCount     Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration   AgentIntegration?    @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  template      WhatsAppTemplate?    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  sender        EmailSender?         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emailTemplate EmailTemplate?       @relation(fields: [emailTemplateId], references: [id], onDelete: Restrict)
  recipients    BroadcastRecipient[]
  lists         BroadcastList[]

  @@index([workspaceId, status])
  @@index([status, scheduledAt])
  @@index([workspaceId, channel])
  @@map("broadcasts")
}

/// O conteúdo de um e-mail de campanha, em blocos.
///
/// ## Por que blocos e não HTML
///
/// `blocks` é uma lista de blocos tipados (título, texto, imagem, botão,
/// divisor), traduzida para HTML por `src/lib/email/blocos.ts`. Guardar HTML
/// cru pareceria mais simples e custaria três coisas: o dono da clínica teria de
/// escrever HTML; um `<script>` ou um `onerror=` colado de fora viraria problema
/// nosso (e o projeto não tem sanitizador); e a casca não poderia mudar depois —
/// melhorar o rodapé obrigaria a reescrever cada template já salvo.
///
/// Com blocos, o conteúdo é dado e a aparência é código: o mesmo template
/// renderiza melhor quando a casca melhora, e não há caminho para HTML
/// arbitrário entrar no e-mail.
model EmailTemplate {
  id          String @id @default(cuid())
  workspaceId String
  name        String

  /// Assunto e prévia padrão. A campanha pode sobrescrever — ver `Broadcast.subject`.
  subject   String?
  preheader String?

  /// A lista de blocos. Forma validada em `src/lib/email/blocos.ts`, não aqui:
  /// acrescentar um tipo de bloco não deve ser migração.
  blocks Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@index([workspaceId])
  @@map("email_templates")
}

/// Quais listas uma campanha mira. Os destinatários são congelados no disparo
/// (em `BroadcastRecipient`); este vínculo é a escolha feita no rascunho.
model BroadcastList {
  broadcastId String
  listId      String

  broadcast Broadcast   @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([broadcastId, listId])
  @@index([listId])
  @@map("broadcast_lists")
}

model BroadcastRecipient {
  id          String  @id @default(cuid())
  broadcastId String
  contactId   String
  /// O endereço congelado no disparo — a ficha pode mudar depois. MSISDN numa
  /// campanha de WhatsApp, e-mail numa de e-mail; qual dos dois é dito pelo
  /// `channel` da campanha.
  to          String
  status      String  @default("pending") // pending|sent|delivered|read|failed|skipped
  /// A Message gerada, quando enviada. Liga o recibo da Meta ao destinatário.
  /// Nulo em campanha de e-mail: e-mail não abre conversa, então não há Message.
  messageId   String?
  error       String?

  /// O `MessageId` do SES. É a chave pela qual o recibo (entrega, abertura,
  /// clique, reclamação) encontra este destinatário — procurar pelo endereço
  /// seria ambíguo, porque o mesmo contato pode estar em duas campanhas ao
  /// mesmo tempo.
  sesMessageId String?

  /// Primeira abertura e primeiro clique. **Primeira**, não a última: o SES
  /// emite um evento por abertura, e quem abre cinco vezes não é cinco pessoas.
  /// Contar aberturas repetidas é relatório, e relatório sai dos eventos.
  openedAt  DateTime?
  clickedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  /// O recibo do SES chega com o `MessageId` e nada mais. Sem este índice, cada
  /// evento viria a ser uma varredura da tabela inteira — e são até nove eventos
  /// por e-mail enviado.
  @@index([sesMessageId])
  @@map("broadcast_recipients")
}

// ───────────────────────────── Formulários de captura ─────────────────────────────

/// Um formulário de captura de leads, para o site da organização.
///
/// Pedido do Andre em 20/11/2026 (Marketing → Formulários). O formulário vive
/// numa página pública (`/f/<chave>`) que o site embute num `iframe` ou abre
/// por link; cada envio vira uma ficha de contato (ou completa a que já
/// existe), um negócio no funil padrão e um registro aqui.
///
/// ## Por que os campos são JSON
///
/// A lista de campos é o desenho do formulário — tipo, rótulo, obrigatório,
/// opções, para onde o valor vai na ficha. Acrescentar um tipo de campo não
/// deve ser migração, pelo mesmo motivo dos blocos do e-mail e do gatilho do
/// funil. A forma é validada em `lib/formularios/schema.ts`, nos dois lados.
model LeadForm {
  id          String @id @default(cuid())
  workspaceId String
  name        String

  /// A chave da URL pública. Identifica o formulário; **não autoriza nada**
  /// além de enviar um formulário — que é o que um visitante faz.
  publicKey String @unique

  /// `draft` | `published`. Só o publicado recebe envios e abre em `/f/`.
  status String @default("draft")

  /// Os campos, na ordem. Ver `campoSchema`.
  fields Json
  /// Textos, aparência e o que acontece com o lead. Ver `configuracaoSchema`.
  settings Json

  /// A origem comercial que a ficha nova recebe — a mesma lista da linha e do
  /// negócio (PRODUCT.md §10). Nula é "não sabemos", que é resposta válida.
  originId String?
  /// **Aposentada em 20/11/2026, e a coluna fica.**
  ///
  /// Era o responsável fixo do negócio criado. O Andre trocou a regra: o lead
  /// é distribuído pela política da conta — rodízio ou balanceado, respeitando
  /// "só disponíveis" —, a mesma das conversas (PRODUCT.md §17). Um nome fixo
  /// no formulário mandava todo lead para a mesma pessoa, inclusive de férias.
  ///
  /// Nenhum código a lê. Derrubá-la seria migração destrutiva por um campo que
  /// não incomoda; sai na próxima fase contract, junto do `NOT NULL` de
  /// `pipeline_stages.pipelineId`.
  assignedUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  origin      Origin?              @relation(fields: [originId], references: [id], onDelete: SetNull)
  submissions LeadFormSubmission[]

  @@index([workspaceId])
  @@map("lead_forms")
}

/// Um envio de formulário — o lead como chegou, antes de virar ficha.
///
/// Guardado inteiro (`data`) porque a ficha só recebe o que os campos mapeiam
/// (nome, telefone, e-mail, observações); o resto — "qual tratamento te
/// interessa?", "como conheceu?" — é resposta que a equipe lê aqui e no resumo
/// que vai para as observações do negócio.
model LeadFormSubmission {
  id          String  @id @default(cuid())
  workspaceId String
  formId      String
  /// A ficha que recebeu este envio. `SetNull` para o envio sobreviver à ficha.
  contactId   String?

  /// As respostas, por id de campo.
  data      Json
  ip        String?
  userAgent String?
  /// A página onde o formulário estava (`Referer`), para saber de onde o lead veio.
  pageUrl   String?
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  form      LeadForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([formId, createdAt])
  @@index([contactId])
  @@map("lead_form_submissions")
}

// ───────────────────────────── Funil (B3) ─────────────────────────────

/// Uma sequência automática: um gatilho e passos que acontecem ao longo do tempo.
///
/// ## Por que isto não é mais uma `AgentRule`
///
/// `AgentRule` é condição→ação **sem estado**: ela dispara e acaba. Um funil
/// precisa lembrar em que passo cada pessoa está, esperar dias entre um passo e
/// outro, e retomar de onde parou. É estado por contato, e é isso que o
/// diferencia.
///
/// ## Onde o estado mora
///
/// **Não aqui.** Quem guarda o ponteiro é o Cloudflare Workflows: cada
/// `FunnelRun` tem um `instanceId`, e o passo atual, as variáveis e o alarme da
/// espera vivem dentro da instância. Este modelo guarda o **desenho** (o que o
/// funil faz) e a **correlação** (quem está dentro, e qual instância é dele).
///
/// Duplicar o ponteiro aqui pareceria útil e seria a pior escolha: duas fontes
/// para o mesmo fato, divergindo na primeira vez que a instância avançasse e a
/// gravação falhasse.
model Funnel {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  description String?

  /// O que faz alguém entrar. Forma validada em `src/lib/funil/gatilho.ts`:
  /// etiqueta aplicada, mudança de etapa do negócio, entrada em lista, contato
  /// criado. Json porque acrescentar um gatilho não deve ser migração.
  trigger Json

  /// `draft` | `published`. Só `published` recebe gente.
  ///
  /// Rascunho→publicar é ato explícito, como o ciclo que o PLANO.md pede para o
  /// agente: um funil meio escrito que já começasse a mandar mensagem seria o
  /// pior desfecho possível de "estou só experimentando".
  status String @default("draft")

  /// Sobe a cada publicação. Quem já está dentro continua rodando a versão com
  /// que entrou — mudar o funil no meio do caminho de quem já está nele daria
  /// sequências pela metade, com passos que nunca existiram para aquela pessoa.
  version Int @default(1)

  /// Quantos podem estar dentro ao mesmo tempo. Nulo = sem teto.
  maxAtivos Int?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps     FunnelStep[]
  runs      FunnelRun[]

  @@index([workspaceId, status])
  @@map("funnels")
}

/// Um passo do funil.
///
/// `config` guarda o que o passo faz (texto da mensagem, dias de espera,
/// etiqueta a aplicar) e `edges` para onde ele vai. Json nos dois porque o
/// catálogo de passos cresce, e uma coluna por tipo de passo viraria uma
/// migração por melhoria.
model FunnelStep {
  id       String @id @default(cuid())
  funnelId String

  /// `mensagem` | `espera` | `condicao` | `etiquetar` | `mover_etapa` |
  /// `atribuir` | `encerrar`. Validado em `src/lib/funil/passos.ts`.
  type   String
  config Json

  /// A ordem no desenho, e a posição no canvas. `order` é o que o motor segue
  /// quando não há aresta explícita; `x`/`y` são só do React Flow.
  order Int
  x     Float @default(0)
  y     Float @default(0)

  /// Para onde ir depois. `{ "padrao": "<stepId>" }` no caso simples;
  /// `{ "sim": "<id>", "nao": "<id>" }` numa condição. Vazio = fim do funil.
  edges Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId, order])
  @@map("funnel_steps")
}

/// A passagem de um contato por um funil.
///
/// Uma linha por contato por funil. O `instanceId` liga à instância do
/// Workflows, que é quem de fato executa — aqui se guarda o suficiente para a
/// tela mostrar quem está dentro e para o motor **parar** quem precisa parar.
model FunnelRun {
  id        String @id @default(cuid())
  funnelId  String
  contactId String

  /// A instância do Cloudflare Workflows. Nulo só entre criar a linha e criar
  /// a instância — janela de milissegundos, e é por isso que a listagem tolera.
  instanceId String?

  /// A versão do funil com que esta pessoa entrou. Publicar de novo não muda
  /// quem já está dentro.
  version Int @default(1)

  /// `running` | `done` | `stopped` | `failed`.
  ///
  /// `stopped` é saída por **freio**, não por fim: humano assumiu a conversa,
  /// contato pediu para parar, funil despublicado. É estado diferente de `done`
  /// de propósito — na tela, "parou porque alguém atendeu" e "terminou" contam
  /// histórias opostas sobre o funil.
  status String @default("running")

  /// Por que parou, quando parou por freio. Texto curto, para a tela dizer.
  stoppedReason String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  funnel  Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Uma passagem **por vez**, e a trava NÃO está aqui.
  ///
  /// Ela é um índice único **parcial** — `(funnelId, contactId) WHERE status =
  /// 'running'` —, declarado em
  /// `migrations/20261109030000_funil_uma_passagem_por_vez`. Prisma não
  /// expressa índice parcial, e um `@@unique` cheio seria a regra errada:
  /// valeria para sempre, e o contato ficaria permanentemente fora do funil
  /// depois da primeira passagem. Um funil de retorno anual pegaria cada
  /// paciente uma vez na vida.
  ///
  /// `migrate diff` relata esse índice como diferença, junto das colunas
  /// geradas e dos índices de vetor, que também só existem no SQL.
  @@index([funnelId, status])
  @@index([contactId])
  @@map("funnel_runs")
}

/// Um documento de treinamento do agente, em Markdown.
///
/// Existe por duas razões, e a segunda só apareceu ao medir o sistema:
///
/// **1. É o suporte do método.** O treinamento deixou de ser uma dúzia de
/// campos avulsos e passou a ser sete documentos em Markdown, catalogados em
/// `src/lib/treinamento/documentos.ts`. Uma linha por documento, em vez de sete
/// colunas novas num `Agent` que já é largo — e acrescentar o oitavo documento
/// deixa de ser migração.
///
/// **2. É o que torna a reindexação possível.** `knowledge_documents` guarda
/// **trechos**, nunca a fonte: a coluna `metadata` dela nunca foi escrita e o
/// arquivo enviado não é persistido. Então, quando o corte do acervo melhora
/// (como melhorou ao passar a respeitar cabeçalho de Markdown), **não há de onde
/// recortar de novo** — reconstruir a fonte a partir dos trechos duplicaria a
/// sobreposição. Aqui o texto-fonte fica, e reindexar é relançar o conteúdo.
model AgentTrainingDoc {
  id      String @id @default(cuid())
  agentId String

  /// A chave do catálogo. **Nunca muda**, mesmo que o título na tela mude: é por
  /// ela que o conteúdo é achado e que os trechos indexados são substituídos.
  /// Trocar um slug é perder o documento e o acervo dele.
  slug String

  /// O Markdown como o admin escreveu. É a fonte, não o resultado do corte.
  ///
  /// **É o que está no ar.** O agente responde por este texto, e ele só muda ao
  /// publicar.
  content String @db.Text

  /// O rascunho, ao lado do que está no ar. Nulo quer dizer "sem rascunho".
  ///
  /// Até o passo 4, "Salvar" publicava: o texto ia direto para `content` e o
  /// agente passava a responder por ele na mensagem seguinte. Com isso era
  /// impossível medir antes de publicar — não havia dois estados para comparar —,
  /// e o princípio 5 do estudo (nada publica sem número) não tinha onde morar.
  draftContent String? @db.Text

  /// O hash do conteúdo na última indexação.
  ///
  /// É o que evita pagar embedding do acervo inteiro a cada salvar: só o
  /// documento cujo hash mudou volta para a fila. Sem isto, salvar uma vírgula
  /// em Instruções centrais reindexaria os sete.
  indexedHash String?

  /// Quando foi indexado, e em quantos trechos.
  ///
  /// Os dois são para a tela dizer "indexado em 34 trechos às 14h32". Documento
  /// de modo `prompt` não é indexado, e nestes os dois ficam nulos — é o estado
  /// correto, não pendência.
  indexedAt     DateTime?
  indexedChunks Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Um documento por slug por agente. É esta restrição que faz o salvar ser um
  /// `upsert` em vez de uma decisão de quem escreve a rota.
  @@unique([agentId, slug])
  @@index([agentId])
  @@map("agent_training_docs")
}

/**
 * O instantâneo de cada publicação do treinamento.
 * Guarda os sete documentos como estavam, em JSON, porque é exatamente o que a
 * volta atrás precisa. Guardar diff seria menor e exigiria reconstruir o estado
 * aplicando a cadeia inteira — caro de escrever e fácil de errar justamente no
 * momento em que alguém está tentando desfazer um estrago.
 * **Os trechos do acervo não são versionados.** Eles são derivados do texto, e a
 * reindexação os reconstrói de graça; guardar geração antiga de embedding
 * dobraria a tabela para não comprar nada.
 */
model AgentTrainingVersion {
  id      String @id @default(cuid())
  agentId String
  version Int

  /// `[{ slug, content }]` com TODOS os documentos, não só os que mudaram:
  /// instantâneo pela metade não serve para voltar atrás.
  docs Json

  /// Os slugs que esta publicação mudou. Derivável do instantâneo anterior, mas
  /// guardado porque é o que a tela mostra e o que liga "mexeu em Serviços" a
  /// "a recuperação de preço melhorou".
  changed Json

  note        String?
  publishedBy String?
  createdAt   DateTime @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Uma versão por número por agente: é o que impede duas publicações
  /// simultâneas de gravarem a "versão 4" duas vezes e deixarem a volta atrás
  /// ambígua.
  @@unique([agentId, version])
  @@index([agentId, createdAt])
  @@map("agent_training_versions")
}

/**
 * O conjunto dourado: os casos que o instrutor aprovou no console de ensaio.
 * Nasce de "guardar este caso", que é a única fonte possível neste produto. A
 * segunda fonte da literatura — o atendente editar uma resposta sugerida antes
 * de enviar — não existe aqui, porque o agente envia direto, sem sugestão.
 */
model EvaluationCase {
  id          String @id @default(cuid())
  workspaceId String
  agentId     String

  question String @db.Text

  /// Os trechos que a busca entregou naquele ensaio, com o caminho do cabeçalho.
  ///
  /// Guardados para o juiz poder perguntar "a resposta se apoia nisto?" sem
  /// rodar a busca de novo — e para o caso continuar significando a mesma coisa
  /// se o acervo mudar depois. Sem isso, um caso de hoje seria julgado contra o
  /// material de amanhã.
  chunks Json

  /// A resposta que o instrutor aprovou, ou a correção que ele escreveu.
  reference String @db.Text

  /// `aprovado` (a resposta do agente estava boa) ou `corrigido` (o instrutor
  /// reescreveu). Caso corrigido é material de exemplo de estilo; caso aprovado
  /// é só regressão.
  kind String @default("aprovado")

  createdBy String?
  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("evaluation_cases")
}

/**
 * O resultado de cada bateria de avaliação.
 * Persiste porque o valor da medição é o **histórico**: "preferiu a resposta de
 * agora em 68% dos casos" só quer dizer algo ao lado do que a bateria anterior
 * deu. O script de medição de recuperação só imprime no terminal, e é por isso
 * que ninguém sabe se o acerto subiu ou caiu desde a semana passada.
 */
model Evaluation {
  id          String @id @default(cuid())
  workspaceId String
  agentId     String

  /// A versão publicada quando esta bateria rodou.
  version Int

  /// `regressao` (o agente de agora contra a referência aprovada) ou `pareado`
  /// (rascunho contra publicado), quando este último existir.
  kind String @default("regressao")

  cases  Int @default(0)
  wins   Int @default(0)
  losses Int @default(0)
  ties   Int @default(0)

  /// Vereditos que o parser não entendeu. Contados à parte, **nunca** somados ao
  /// denominador: parser que chuta "empate" injeta dado inventado na métrica que
  /// decide se o treinamento vai ao ar.
  unreadable Int @default(0)

  preference Float?

  /// Os avisos do canário: preferência de 100%, empate em tudo, amostra pequena.
  warnings Json

  /// O detalhe por caso, para a tela poder abrir "quais pioraram".
  details Json

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@map("evaluations")
}

/// Um recado entre duas pessoas da mesma unidade.
///
/// **É comunicação de equipe, não atendimento.** Não tem `Conversation`, não
/// tem contato e não entra no histórico do paciente — o que passa por aqui é o
/// "o paciente do 14h remarcou" que hoje acontece no WhatsApp pessoal de cada
/// um, fora do sistema e fora de qualquer registro.
///
/// ## Por que uma tabela, e não só o tempo real
///
/// O caminho de entrega é efêmero (`transmitir`, direto para o Durable Object),
/// porque recado que chega um minuto depois não serve. Mas quem está offline
/// precisa achar o recado ao voltar, e quem recebeu precisa de um contador que
/// não dependa de a aba ter estado aberta na hora. Tempo real entrega; a tabela
/// lembra.
///
/// ## O escopo é a unidade, e isso é a fronteira
///
/// `workspaceId` em toda consulta, como todo o resto do produto. Numa conta
/// Multiclínica, quem está na Unidade Centro não manda recado para a Unidade
/// Sul: são equipes diferentes, com agenda diferente, e o recado é sobre o
/// trabalho de hoje naquele lugar.
model TeamMessage {
  id          String @id @default(cuid())
  workspaceId String

  fromUserId String
  toUserId   String

  /// O texto, como foi escrito — com as menções em `@nome`.
  ///
  /// Teto de 2.000 no corpo da rota. Recado é recado: o que não cabe aqui é
  /// assunto de conversa, e o produto já tem onde ter conversa.
  body String

  /// De qual conversa este recado veio, quando veio de uma.
  ///
  /// Nulo no recado comum, que é conversa entre duas pessoas da equipe e não
  /// fala de paciente nenhum. Preenchido no **encaminhamento**: é o que faz o
  /// recado carregar o atalho "Abrir a conversa de Marina".
  ///
  /// `SetNull` e não `Cascade`: apagar a conversa não pode apagar o recado. O
  /// que a colega escreveu continua sendo parte da conversa *dela* — só o
  /// atalho deixa de existir, e a tela já sabe renderizar recado sem link.
  conversationId String?
  /// Qual mensagem foi encaminhada, quando foi uma só.
  ///
  /// É o trecho citado no recado. Separado de `conversationId` porque dá para
  /// encaminhar a conversa inteira sem apontar uma mensagem — e aí este fica
  /// nulo e o recado mostra só o link.
  messageId      String?

  /// Quando o destinatário abriu. Nulo é "não lido", e é o que o contador conta.
  readAt DateTime?

  createdAt DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from         User          @relation("RecadosEnviados", fields: [fromUserId], references: [id], onDelete: Cascade)
  to           User          @relation("RecadosRecebidos", fields: [toUserId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  /// A caixa de entrada: "os meus não lidos", e "a minha conversa com fulano".
  @@index([workspaceId, toUserId, readAt])
  @@index([workspaceId, toUserId, fromUserId, createdAt])
  @@map("team_messages")
}

/// Quem da Venn360 entrou na conta de qual cliente, e quando saiu.
///
/// **É o que torna a entrada defensável.** Assumir a conta de um cliente é um
/// poder real: o operador passa a ver conversa de paciente e a poder gravar em
/// nome da clínica. Um poder desses sem registro é indistinguível de invasão —
/// inclusive para nós, no dia em que alguém perguntar.
///
/// A tarja na tela promete isto ao operador, e a mesma promessa é feita ao
/// cliente: o registro é dele também.
///
/// Não registra cada gravação, e é decisão: o que ele escreve já fica atribuído
/// ao **userId dele**, porque a sessão continua sendo a dele — não há troca de
/// identidade, só de unidade. O que faltava era o recorte de tempo: de quando a
/// que horas ele esteve lá dentro.
model PlatformAccessLog {
  id String @id @default(cuid())

  /// Quem entrou. Sempre um OWNER do workspace de plataforma.
  userId String

  /// Em que conta entrou — e em que unidade dela.
  accountId   String
  workspaceId String

  /// `leitura` (espiar) ou `total` (entrar). Dois atos diferentes.
  modo String

  /// Por que entrou, quando o operador escreve. Opcional de propósito: exigir
  /// justificativa em campo livre produz "suporte" em 100% das linhas.
  motivo String?

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([accountId, startedAt])
  @@index([userId, startedAt])
  @@map("platform_access_log")
}
