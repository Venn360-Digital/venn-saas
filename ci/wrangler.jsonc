{
    // O Worker de CI não atende ninguém: ele existe para o Workers Builds ter
    // o que publicar ao fim do build de verificação (scripts/ci-worker.mjs).
    // O valor está no build que precede este deploy, não neste Worker — sem
    // rota, sem workers.dev, sem observabilidade.
    "name": "odontobox-ci",
    "main": "worker.js",
    "compatibility_date": "2025-06-01",
    "workers_dev": false,
    "observability": { "enabled": false }
}
