# VPS dedicada ao Evolution Go — copie para .env.evolution-vps e preencha.
# NÃO comitar o .env preenchido.

# Chave global/admin do Evolution Go. A MESMA que o app guarda como
# EVOLUTION_GO_API_KEY (Cloudflare secret) — os dois lados conferem.
EVOLUTION_GO_API_KEY=

# Senha do Postgres dedicado do Evolution (só vive nesta VPS).
EVO_DB_PASSWORD=

# Token do Cloudflare Tunnel (criado no painel: Zero Trust → Networks → Tunnels).
# Rota o hostname público para http://evolution-go:8080.
CLOUDFLARE_TUNNEL_TOKEN=

# Fuso do host (o app já conta o fuso explicitamente; isto é só para logs).
TZ=America/Sao_Paulo
