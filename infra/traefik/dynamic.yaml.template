# Traefik file provider — TEMPLATE.
#
# Rendered to dynamic.yaml by infra/scripts/generate-secrets.mjs (and by
# scripts/render-traefik.mjs on its own, if the domain changes). The file
# provider does not interpolate environment variables in a plain .yaml, so the
# domain is substituted ahead of time.
#
# Routes the Supabase services, which come from the vendored upstream compose and
# therefore carry no labels of ours — an included Compose service cannot be
# re-declared in infra/compose.yaml to add them.
#
# Only the API gateway is published. Studio is deliberately absent: it has full
# database access, so it is reached over an SSH tunnel instead
# (see infra/README.md).

http:
  routers:
    supabase-api:
      rule: "Host(`__API_HOST__`)"
      entryPoints:
        - websecure
      service: supabase-gateway
      tls:
        certResolver: le

  services:
    supabase-gateway:
      loadBalancer:
        servers:
          # Upstream renamed the gateway service from `kong` to `api-gw` (the
          # gateway is pluggable now — see docker-compose.kong.yml and the
          # envoy/caddy/nginx variants). The name here must track that file.
          - url: "http://api-gw:8000"
        passHostHeader: true
