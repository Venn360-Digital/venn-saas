        "cf": "^1.0.0-beta.20",
        "eslint": "^9",
        "eslint-config-next": "16.4.2",
        "prisma": "6.19.3",
        "tailwindcss": "^4",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5",
        "vinext": "1.3.0",
        "vite": "8.3.5"
