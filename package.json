{
    "name": "venn.odontobox360",
    "version": "0.1.0",
    "private": true,
    "imports": {
        "#prisma": {
            "workerd": "./src/generated/prisma-workerd/client.ts",
            "default": "./src/generated/prisma/client.ts"
        }
    },
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "lint:colors": "node scripts/lint-colors.mjs",
        "prebuild": "node scripts/lint-colors.mjs && node scripts/lint-workspace.mjs && node scripts/lint-fuso.mjs && node scripts/check-widget.mjs",
        "check:period": "tsx --conditions=react-server scripts/check-period.ts",
        "check:operacao": "tsx --conditions=react-server scripts/check-operacao.ts",
        "test:availability": "tsx scripts/test-availability.ts",
        "check:widget": "node scripts/check-widget.mjs",
        "lint:workspace": "node scripts/lint-workspace.mjs",
        "lint:fuso": "node scripts/lint-fuso.mjs",
        "check:cofre": "tsx --conditions=react-server scripts/check-cofre.ts",
        "check:neon": "tsx --conditions=react-server scripts/check-neon.ts",
        "check:storage": "tsx --conditions=react-server scripts/check-storage.ts",
        "check:auth": "tsx --conditions=react-server scripts/check-auth.ts",
        "migrar:usuarios": "tsx --conditions=react-server scripts/migrar-usuarios.ts",
        "check:trabalhos": "tsx --conditions=react-server scripts/check-trabalhos.ts",
        "check:envelopes": "tsx --conditions=react-server scripts/check-envelopes.ts",
        "check:filas": "tsx --conditions=react-server scripts/check-filas.ts",
        "check:tenant": "tsx --conditions=react-server scripts/check-tenant.ts",
        "check:tempo-real": "tsx --conditions=react-server scripts/check-tempo-real.ts",
        "typecheck:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
        "dev:vinext": "BUILD_TARGET=cloudflare vite dev --port 3001",
        "build:vinext": "BUILD_TARGET=cloudflare vite build",
        "start:vinext": "BUILD_TARGET=cloudflare vite preview",
        "deploy:vinext": "BUILD_TARGET=cloudflare vinext-cloudflare deploy",
        "check:fuso": "tsx --conditions=react-server scripts/check-fuso.ts",
        "check:paridade": "tsx scripts/check-paridade.ts",
        "audit:isolation": "node scripts/audit-isolation.mjs",
        "db:migrate:guarded": "node scripts/migrate-guarded.mjs",
        "db:migrate:unsafe": "prisma migrate deploy",
        "medir:recuperacao": "tsx scripts/medir-recuperacao.ts",
        "test:audio": "tsx scripts/test-audio.ts",
        "test:chunker": "tsx scripts/test-chunker.ts",
        "test:consulta": "tsx scripts/test-consulta.ts",
        "test:treinamento": "tsx scripts/test-treinamento.ts",
        "test:prompt": "tsx scripts/test-prompt.ts",
        "check:treinamento": "tsx scripts/check-treinamento.ts"
