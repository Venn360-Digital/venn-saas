    "check:envelopes": "tsx --conditions=react-server scripts/check-envelopes.ts",
    "check:filas": "tsx --conditions=react-server scripts/check-filas.ts",
    "check:tenant": "tsx --conditions=react-server scripts/check-tenant.ts",
    "check:tempo-real": "tsx --conditions=react-server scripts/check-tempo-real.ts",
    "typecheck:cloudflare": "tsc --noEmit -p tsconfig.cloudflare.json",
    "dev:vinext": "BUILD_TARGET=cloudflare vite dev --port 3001",
    "build:vinext": "BUILD_TARGET=cloudflare vite build",
    "start:vinext": "BUILD_TARGET=cloudflare vite preview",
    "deploy:vinext": "BUILD_TARGET=cloudflare vinext-cloudflare deploy",
    "build:preview": "DEPLOY_ENV=stg BUILD_TARGET=cloudflare CF_PREVIEW=1 vite build",
    "deploy:preview": "DEPLOY_ENV=stg BUILD_TARGET=cloudflare CF_PREVIEW=1 vinext-cloudflare previews deploy",
    "check:fuso": "tsx --conditions=react-server scripts/check-fuso.ts",
    "check:paridade": "tsx scripts/check-paridade.ts",
    "audit:isolation": "node scripts/audit-isolation.mjs",
    "migrate:prod": "node scripts/migrate-guarded.mjs --expect-slug odontobox --expect-env production",
    "migrate:stg": "node scripts/migrate-guarded.mjs --expect-slug odontobox --expect-env stg",
    "portao:prod": "npm run migrate:prod && npm run audit:isolation -- --strict",
    "portao:stg": "npm run migrate:stg && npm run audit:isolation -- --strict",
    "build:prod": "npm run build:vinext",
    "build:stg": "DEPLOY_ENV=stg npm run build:vinext",
    "deploy:prod": "npm run deploy:vinext",
    "deploy:stg": "DEPLOY_ENV=stg npm run deploy:vinext",
    "smoke:prod": "node scripts/smoke-identity.mjs production",
    "smoke:stg": "node scripts/smoke-identity.mjs stg",
    "lint:migracoes": "node scripts/lint-migracoes.mjs",
    "db:migrate:guarded": "node scripts/migrate-guarded.mjs",
    "db:migrate:unsafe": "prisma migrate deploy",
    "medir:recuperacao": "tsx scripts/medir-recuperacao.ts",
    "test:audio": "tsx scripts/test-audio.ts",
    "test:marcacao": "tsx scripts/test-marcacao.ts",
    "test:mencoes": "tsx scripts/test-mencoes.ts",
    "test:retratos": "tsx --conditions=react-server scripts/test-retratos.ts",
    "test:recortes": "tsx --conditions=react-server scripts/test-recortes.ts",
    "test:portao": "tsx --conditions=react-server scripts/test-portao.ts",
    "test:convite": "tsx --conditions=react-server scripts/test-convite.ts",
    "test:sonda": "tsx scripts/test-sonda.ts",
    "test:chunker": "tsx scripts/test-chunker.ts",
    "test:consulta": "tsx scripts/test-consulta.ts",
    "test:treinamento": "tsx scripts/test-treinamento.ts",
    "test:prompt": "tsx scripts/test-prompt.ts",
    "test:fusao": "tsx scripts/test-fusao.ts",
    "test:escalada": "tsx scripts/test-escalada.ts",
        "test:distribuicao": "tsx scripts/test-distribuicao.ts",
    "test:juiz": "tsx scripts/test-juiz.ts",
    "test:versao": "tsx scripts/test-versao.ts",
    "test:agrupar": "tsx scripts/test-agrupar.ts",
    "test:cenarios": "tsx scripts/test-cenarios.ts",
    "test:regras": "tsx scripts/test-regras.ts",
    "test:condicoes": "tsx scripts/test-condicoes.ts",
    "check:treinamento": "tsx scripts/check-treinamento.ts"
  },
