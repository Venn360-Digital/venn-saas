{
  "name": "venn.odontobox360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:workers": "tsc --noEmit -p workers/tsconfig.json",
    "worker:dev": "tsx watch --tsconfig workers/tsconfig.json workers/src/index.ts",
    "worker:build": "tsup --config workers/tsup.config.ts",
    "worker:start": "node workers/dist/index.js",
    "lint:colors": "node scripts/lint-colors.mjs",
    "prebuild": "node scripts/lint-colors.mjs && node scripts/lint-workspace.mjs && node scripts/check-widget.mjs",
    "check:period": "tsx --conditions=react-server scripts/check-period.ts",
    "check:operacao": "tsx --conditions=react-server scripts/check-operacao.ts",
    "test:availability": "tsx scripts/test-availability.ts",
    "check:widget": "node scripts/check-widget.mjs",
    "lint:workspace": "node scripts/lint-workspace.mjs",
    "check:cofre": "tsx --conditions=react-server scripts/check-cofre.ts",
    "check:neon": "tsx --conditions=react-server scripts/check-neon.ts",
    "check:storage": "tsx --conditions=react-server scripts/check-storage.ts",
    "check:auth": "tsx --conditions=react-server scripts/check-auth.ts",
    "migrar:usuarios": "tsx --conditions=react-server scripts/migrar-usuarios.ts"
  },
  "dependencies": {
    "@capsizecss/metrics": "^3.6.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@langchain/community": "^1.1.10",
    "@langchain/core": "^1.1.18",
    "@langchain/openai": "^1.2.4",
    "@langchain/textsplitters": "^1.0.1",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "@types/bcryptjs": "^2.4.6",
    "aws4fetch": "1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.12",
    "bullmq": "^6.3.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.1.0",
    "ioredis": "^6.0.0",
    "langchain": "^1.2.16",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "openai": "^6.17.0",
    "pdf-parse": "^2.4.5",
    "pg": "8.16.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "typechat": "^0.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@next/swc-darwin-x64": "^16.1.6",
    "@tailwindcss/oxide-darwin-x64": "^4.1.18",
    "lightningcss-darwin-x64": "^1.31.1"
  }
}
