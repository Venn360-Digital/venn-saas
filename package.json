        "next": "16.4.2",
        "next-themes": "^0.4.6",
        "openai": "^6.17.0",
        "pdf-parse": "^2.4.5",
        "pg": "8.16.3",
        "radix-ui": "^1.4.3",
        "react": "19.3.1",
        "react-day-picker": "^10.0.2",
        "react-dom": "19.3.1",
        "react-hook-form": "^7.71.1",
        "react-server-dom-webpack": "^19.3.1",
        "server-only": "^0.0.1",
        "sonner": "^2.0.7",
