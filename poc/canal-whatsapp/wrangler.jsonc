{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "poc-canal-whatsapp",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-21",
    "observability": { "enabled": true },

    "containers": [
        {
            "class_name": "CanalWhatsApp",

            // Imagem pública do Docker Hub, fixada por versão.
            //
            // Duas razões para não apontar para um Dockerfile: não há Docker
            // nesta máquina, e uma referência de registro dispensa Docker no
            // momento de publicar — é o que torna esta POC publicável daqui.
            //
            // E fixada, não `:latest`: a VPS roda `:latest` há meses, que hoje
            // é idêntico a 0.7.2 pelo digest (sha256:6fa601464bd76d3d…), mas
            // numa atualização do autor o comportamento muda sem ninguém pedir.
            // Existe um 0.7.2-beta de 2026-10-01 que pode ter corrigido o laço
            // de QR; vale testar na POC, não em produção.
            "image": "docker.io/evoapicloud/evolution-go:0.7.2",

            // 256 MiB / 1/16 vCPU / 2 GB. O menor que existe, de propósito: a
            // imagem tem 86 MB e o processo é um Go esperando soquete. Se não
            // couber, a própria falha é a medição que decide subir para `basic`
            // — e é uma diferença de quatro vezes na conta mensal.
            "instance_type": "lite",

            // Teto da POC. Limita o estrago e a fatura enquanto se mede.
            "max_instances": 5
        }
    ],

    "durable_objects": {
        "bindings": [{ "name": "CANAL", "class_name": "CanalWhatsApp" }]
    },

    "exports": {
        "CanalWhatsApp": { "type": "durable-object", "storage": "sqlite" }
    },

    "vars": {
        // Preenchido depois do primeiro `deploy`, quando a URL existe.
        "WEBHOOK_BASE_URL": "https://poc-canal-whatsapp.andre-7ee.workers.dev",

        // Reatar sessões gravadas ao subir. **Fica desligado.**
        //
        // A POC passou a apontar para um `evogo_auth` restaurado da VPS, que
        // carrega a licença real — e, na mesma base, as credenciais de aparelho
        // das clínicas. Com isto em "true", este contêiner disputaria o aparelho
        // com o Evolution Go que está no ar: o WhatsApp aceita uma conexão por
        // aparelho vinculado, os dois se derrubam em laço, e o fim provável é o
        // aparelho desvinculado — número de clínica fora do ar por causa de um
        // teste.
        //
        // Só muda para "true" com o `evolution-go` da VPS parado.
        "REATAR_SESSOES": "false",

        // E-mail do primeiro registro manual da licença.
        //
        // Com ele o Evolution Go chama `/v1/register/auto` ao subir e dispensa
        // o navegador. É segredo e não `vars` em produção — aqui fica como var
        // porque e-mail de operador não é credencial, e deixá-lo visível na
        // config é o que torna óbvio que ele existe.
        //
        // Vazio mantém o registro manual, então preencher errado não quebra:
        // cai no fluxo antigo.
        "EVOLUTION_OPERATOR_EMAIL": ""
    }

    // Segredos por `wrangler secret put`, nunca aqui:
    //   EVOLUTION_GO_API_KEY  chave global do Evolution Go
    //   EVOGO_AUTH_DB         Postgres do whatsmeow (Neon)
    //   EVOGO_USERS_DB        Postgres de usuários do Evolution Go (Neon)
    //   POC_TOKEN             tranca de tudo o que este Worker expõe
}
