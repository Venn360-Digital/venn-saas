{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "poc-canal-whatsapp",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-21",
    "observability": { "enabled": true },

    "containers": [
        {
            "class_name": "CanalWhatsApp",

            // Imagem pública do Docker Hub, fixada por versão.
            //
            // Duas razões para não apontar para um Dockerfile: não há Docker
            // nesta máquina, e uma referência de registro dispensa Docker no
            // momento de publicar — é o que torna esta POC publicável daqui.
            //
            // E fixada, não `:latest`: a VPS roda `:latest` há meses, que hoje
            // é idêntico a 0.7.2 pelo digest (sha256:6fa601464bd76d3d…), mas
            // numa atualização do autor o comportamento muda sem ninguém pedir.
            // Existe um 0.7.2-beta de 2026-10-01 que pode ter corrigido o laço
            // de QR; vale testar na POC, não em produção.
            "image": "docker.io/evoapicloud/evolution-go:0.7.2",

            // `basic`: 1 GiB / 1/4 vCPU / 4 GB.
            //
            // Nasceu `lite` (1/16 vCPU) — o menor que existe —, com a aposta de
            // que um Go esperando soquete não precisaria de mais. A medição
            // desfez a aposta: em 2026-10-23, com os dois tails cruzados, o
            // `/send/text` levava ~4,8 s, e ~4,4 s eram DENTRO do contêiner. A
            // criptografia do Signal por mensagem é CPU, e 1/16 de vCPU é o
            // gargalo — não o banco nem a rede. Na VPS o mesmo envio era bem
            // abaixo de 1 s.
            //
            // `basic` dá 4× a vCPU. A conta sobe ~4× no contêiner **de pé**
            // (ver `custoMensal` em `decisoes.ts`), e para uma clínica isso é
            // centavos contra segundos na frente do paciente. Se `basic` não
            // chegar perto de 1 s, o próximo passo é medir de novo, não subir
            // às cegas para `standard`.
            "instance_type": "basic",

            /**
             * Teto de salas simultâneas.
             *
             * Era 5, da POC — e cinco salas depois ele virou o defeito: o
             * contorno pós-pareamento **para e sobe** o contêiner, e sem uma
             * folga a subida falha com "Container crashed while checking for
             * ports". Medido em 2026-10-23: a linha pareava, reciclava, reatava
             * e então morria porque não havia vaga para voltar.
             *
             * Uma sala por linha de WhatsApp, mais a da licença, mais a folga do
             * reinício. Vinte cobre a homologação com margem; a conta por
             * contêiner está em `decisoes.ts` (`custoMensal`) e o que paga é o
             * contêiner **de pé**, não o teto.
             */
            "max_instances": 20
        }
    ],

    "durable_objects": {
        "bindings": [{ "name": "CANAL", "class_name": "CanalWhatsApp" }]
    },

    // Service binding para o Worker do app. O repasse de evento do /entrada vai
    // por aqui — `fetch` público de um Worker para o workers.dev de outro Worker
    // da mesma conta não atravessa de forma confiável (medido 2026-10-22). É a
    // direção inversa do binding EVOLUTION_GO que o app usa para falar com este.
    "services": [{ "binding": "APP", "service": "odontobox" }],

    "exports": {
        "CanalWhatsApp": { "type": "durable-object", "storage": "sqlite" }
    },

    "vars": {
        // URL pública DESTE Worker — o Evolution Go posta o webhook aqui, no
        // caminho /entrada/{segredo}/{sala}.
        "WEBHOOK_BASE_URL": "https://poc-canal-whatsapp.andre-7ee.workers.dev",

        // Para onde o DO repassa cada evento — o webhook do app.
        "APP_WEBHOOK_URL": "https://odontobox.andre-7ee.workers.dev/api/webhooks/evolution-go",

        // Reatar sessões gravadas ao subir. **Fica desligado.**
        //
        // A POC passou a apontar para um `evogo_auth` restaurado da VPS, que
        // carrega a licença real — e, na mesma base, as credenciais de aparelho
        // das clínicas. Com isto em "true", este contêiner disputaria o aparelho
        // com o Evolution Go que está no ar: o WhatsApp aceita uma conexão por
        // aparelho vinculado, os dois se derrubam em laço, e o fim provável é o
        // aparelho desvinculado — número de clínica fora do ar por causa de um
        // teste.
        //
        // Só muda para "true" com o `evolution-go` da VPS parado.
        "REATAR_SESSOES": "false",

        // E-mail do primeiro registro manual da licença.
        //
        // Com ele o Evolution Go chama `/v1/register/auto` ao subir e dispensa
        // o navegador. É segredo e não `vars` em produção — aqui fica como var
        // porque e-mail de operador não é credencial, e deixá-lo visível na
        // config é o que torna óbvio que ele existe.
        //
        // Vazio mantém o registro manual, então preencher errado não quebra:
        // cai no fluxo antigo.
        "EVOLUTION_OPERATOR_EMAIL": "andre@venn360.com"
    }

    // Segredos por `wrangler secret put`, nunca aqui:
    //   EVOLUTION_GO_API_KEY  chave global do Evolution Go
    //   EVOGO_AUTH_DB         Postgres do whatsmeow (Neon)
    //   EVOGO_USERS_DB        Postgres de usuários do Evolution Go (Neon)
    //   POC_TOKEN             tranca de tudo o que este Worker expõe
}
